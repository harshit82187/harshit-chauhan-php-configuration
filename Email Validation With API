<script>
$(document).ready(function () {
    $('#emailValidationForm').on('submit', function (e) {
        e.preventDefault();
        
        let formData = $(this).serialize();
        
        $.ajax({
            type: 'POST',
            url: "{{ route('validate.email') }}",
            data: formData,
            dataType: 'json',
            success: function (response) {
                let responseDiv = $('#emailResponse');
                responseDiv.html(response.message);

                if (response.status === 'success') {
                    responseDiv.css('color', 'green');
                } else {
                    responseDiv.css('color', 'red');
                }
            },
            error: function () {
                $('#emailResponse').html('⚠️ Something went wrong. Please try again.').css('color', 'red');
            }
        });
    });
});
</script>
