<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;

class EmailValidationController extends Controller
{
    public function validateEmail(Request $request)
    {
        $request->validate([
            'email' => 'required|email',
        ]);

        $apiKey = '1f7ec72872a4ec4a465d7b27b2de6f50368bbcde42070e633cdd9438794bbd5c';
        $response = Http::asForm()->post('https://verify.maileroo.net/check', [
            'api_key' => $apiKey,
            'email_address' => $request->email,
        ]);

        $data = $response->json();

        // Check if the API request was successful
        if ($data['success'] && isset($data['data'])) {
            $emailData = $data['data'];

            if ($emailData['format_valid'] && $emailData['mx_found'] && !$emailData['disposable']) {
                return response()->json([
                    'status' => 'success',
                    'message' => '✅ Email is valid and can receive messages.',
                ]);
            } else {
                return response()->json([
                    'status' => 'error',
                    'message' => '❌ Email is invalid or cannot receive messages. Please enter another email.',
                ]);
            }
        } else {
            return response()->json([
                'status' => 'error',
                'message' => '⚠️ Unable to validate email. Please try again later.',
            ]);
        }
    }
}



