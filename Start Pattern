Output :- 

<?php

$row = 5;
$column = 9;

for($i=1;$i<=$row;$i++){
    $k = 1;
    for($j=1;$j<=$column;$j++){
        if($j>=6-$i && $j<=4+$i && $k){
            echo ("*");
            $k = 0;
        }   else{
            echo (" ");
            $k = 1;
        } 
    }
    echo ("\n");
    
}

?>


