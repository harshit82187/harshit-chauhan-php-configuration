 ******* 
*********

Code : 

<?php

$row = 5;
$column = 9;

for($i=1;$i<=$row;$i++){
    
    for($j=1;$j<=$column;$j++){
        if($j>=6-$i && $j<=4+$i){
            echo ("*");
        }   else{
            echo (" ");
        } 
    }
    echo ("\n");
    
}

?>





