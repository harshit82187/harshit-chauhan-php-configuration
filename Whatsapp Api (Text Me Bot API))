use App\Models\BussinessSetting;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;


public function sendWhatsappMessage(Request $req)
    {
        $MobileNo = $req->whatsapp_no;
        $apiSetting = BussinessSetting::where('type', 'apikey')->first();
        $apiKey = $apiSetting?->value;
        $message = "👋 Dear Customer,\n\n" .
            "✅ This is just a *test message* to confirm that the WhatsApp API is working correctly.\n\n" .
            "🧪 *No action is needed.*\n\n" .
            "🛠 This is only for testing. Please ignore.\n\n" .
            "Thanks & Regards,\nReconsult Advisory Team";

        if (!str_starts_with($MobileNo, '+91')) {
            $MobileNo = '+91' . $MobileNo;
        }

        try {
            $response = Http::timeout(30)->get('http://api.textmebot.com/send.php', [
                'recipient' => $MobileNo,
                'apikey'    => $apiKey,
                'text'      => $message
            ]);
            Log::info('WhatsApp API Response', [
                'mobile' => $MobileNo,
                'status' => $response->status(),
                'body'   => $response->body(),
                'json'   => $response->json(),
            ]);
            if ($response->successful()) {
                $body = strtolower($response->body());

                if (str_contains($body, 'error') || str_contains($body, 'failed')) {
                    return back()->with('error',
                        'API responded with failure.<br><b>Response:</b><br>' .
                        nl2br(e($response->body()))
                    );
                }
                return back()->with('success', 'Message sent successfully!');
            }
            return back()->with('error',
                'API Error ❌<br>' .
                '<b>Status:</b> ' . $response->status() . '<br>' .
                '<b>Response:</b><br>' . nl2br(e($response->body()))
            );
        } catch (Exception $e) {
            Log::error('WhatsApp API Exception', [
                'message' => $e->getMessage(),
                'file'    => $e->getFile(),
                'line'    => $e->getLine(),
                'trace'   => $e->getTraceAsString(),
                'mobile'  => $MobileNo,
                'apikey'  => $apiKey,
            ]);
            return back()->with('error',
                'Exception Occurred ❌<br>' .
                '<b>Message:</b> ' . e($e->getMessage()) . '<br>' .
                '<b>File:</b> ' . $e->getFile() . '<br>' .
                '<b>Line:</b> ' . $e->getLine()
            );
        }
    }








