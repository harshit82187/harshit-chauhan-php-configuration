<?php

namespace App\Traits;

use App\Models\BussinessSetting;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

trait sendOtpForWhatsapp
{
    public function sendOtpOnWhatsapp($user, $otp)
    {
        try {
            // dd($user,$otp);
            $mobile = $user->mobile ?? null;
            if (!$mobile) {
                Log::channel('whatsapp-api')->warning('Mobile number missing', [
                    'user_id' => $user->id ?? null,
                ]);
                return false;
            }
            if (!str_starts_with($mobile, '+91')) {
                $mobile = '+91' . ltrim($mobile, '0');
            }
            $apiKey = BussinessSetting::where('type', 'apikey')->value('value');
            if (!$apiKey) {
                Log::channel('whatsapp-api')->error('WhatsApp API key missing');
                return false;
            }
            $message = $this->otpWhatsappMessage($user->name ?? 'User', $otp);
            Log::channel('whatsapp-api')->info('Sending WhatsApp OTP', [
                'mobile' => $mobile,
                'otp'    => $otp,
            ]);
            $response = Http::get('http://api.textmebot.com/send.php', [
                'recipient' => $mobile,
                'apikey'    => $apiKey,
                'text'      => $message
            ]);
            if ($response->successful()) {
                Log::channel('whatsapp-api')->info('WhatsApp OTP sent successfully', [
                    'mobile' => $mobile,
                    'response' => $response->body(),
                ]);
                return true;
            }
            Log::channel('whatsapp-api')->error('WhatsApp OTP failed', [
                'mobile'   => $mobile,
                'status'   => $response->status(),
                'response' => $response->body(),
            ]);
            return false;
        } catch (\Throwable $e) {
            Log::channel('whatsapp-api')->critical('WhatsApp OTP Exception', [
                'error' => $e->getMessage(),
                'line'  => $e->getLine(),
                'file'  => $e->getFile(),
            ]);
            return false;
        }
    }

    private function otpWhatsappMessage($name, $otp)
    {
        return "Hello {$name}, 👋\n\n"
            . "Your login OTP is *{$otp}* 🔐\n"
            . "This OTP is valid for *2 minutes* only.\n\n"
            . "Please do not share this OTP with anyone.\n\n"
            . "Thanks & Regards,\n"
            . "Reconsulant Advisory Team";
    }
}















