    public function login(Request $request){
        // dd($request->all());
        $request->validate([
            'email' => 'required|email',
            'password' => 'required'
        ]);
        $user = User::withTrashed()->where('email', $request->email)->where('status', 1)->first();

        if (checkDeletedAccount($user)) {
            return response()->json([
                'status' => false,
                'message' => 'Your account has been deleted.'
            ], 403);
        }

        if (!$user || !Hash::check($request->password, $user->password)) {
            return response()->json([
                'success' => false,
                'message' => 'Invalid credentials'
            ], 401);
        }

        if ($request->filled('fcm_token')) {
            $user->update([
                'fcm_token' => $request->fcm_token
            ]);
        }

        $token = $user->createToken('user-login-token')->plainTextToken;
        return response()->json([
            'status' => true,
            'message' => 'Login successful',
            'token' => $token,
            'user' => [
                'id' => $user->id,
                'email' => $user->email,
                'mobile_no' => $user->mobile_no,
                'name' => $user->name,
                'image' => $user->image,
                'fcm_token' => $user->fcm_token

            ]
        ]);
    }

    public function register(Request $request){
        // dd($request->all());
        $rules = [
            'name' => 'required|string|max:250',
            'mobile_no' => 'required|unique:users,mobile_no',
            'email' => 'required|email|unique:users,email',
            'password' => 'required|string|min:8',
            'post_code' => 'required|string|max:12',
        ];
        $validator = Validator::make($request->all(), $rules);
        if ($validator->fails()) {
            return response()->json([
                'status' => false,
                'message' => $validator->errors()->first(),
            ], 422);
        }

        $user = User::create([
            'name'     => $request->name,
            'email'    => $request->email,
            'mobile_no'    => $request->mobile_no,
            'post_code'    => $request->post_code,
            'password' => Hash::make($request->password),
            'status' => 1,
            'email_verified_at' => now(),
            'fcm_token' => $request->fcm_token ?? null
        ]);

        $token = $user->createToken('user-register-token')->plainTextToken;
        assignPendingGiftCards($user);
        sendWelcomeEmail($user);
        return response()->json([
            'status' => true,
            'message' => 'Customer registered and logged in successfully',
            'token' => $token,
            'user' => $user,
        ],200);
    }

