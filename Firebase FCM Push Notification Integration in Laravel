    public function store(Request $request){
        \Log::channel('fcm_notification')->info('Announcement Store API Hit', [
            'request' => $request->all()
        ]);

        $request->validate([
            'title' => 'required|string|max:255',
            'type' => 'required|in:1,2,3',
            'message' => 'required|string',
        ]);

        \Log::channel('fcm_notification')->info('Validation Passed');

        // Step 1: Create Announcement
        $announcement = Announcment::create([
            'title' => $request->title,
            'type' => $request->type,
            'message' => $request->message,
            'created_by' => $this->admin->id,
            'notification_for' => 1,
        ]);

        \Log::channel('fcm_notification')->info('Announcement Created', [
            'announcement_id' => $announcement->id
        ]);

        $tokens = [];

        // =========================
        // Selected Users
        // =========================
        if ($request->type == 3 && !empty($request->customer_id)) {

            \Log::channel('fcm_notification')->info('Type 3 Notification Started');

            $data = [];

            foreach ($request->customer_id as $userId) {

                $data[] = [
                    'announcement_id' => $announcement->id,
                    'user_id' => $userId,
                    'is_seen' => 0,
                    'created_at' => now(),
                    'updated_at' => now(),
                ];
            }

            DB::table('announcement_users')->insert($data);

            \Log::channel('fcm_notification')->info('Announcement Users Inserted', [
                'total_users' => count($data)
            ]);

            $tokens = User::whereIn('id', $request->customer_id)
                ->whereNotNull('fcm_token')
                ->distinct()
                ->pluck('fcm_token')
                ->toArray();

            \Log::channel('fcm_notification')->info('FCM Tokens Fetched', [
                'total_tokens' => count($tokens),
                'tokens' => $tokens
            ]);
        }

        // =========================
        // All Users
        // =========================
        elseif ($request->type == 1) {

            \Log::channel('fcm_notification')->info('Type 1 Notification Started');

            $users = User::pluck('id');

            $data = $users->map(function ($id) use ($announcement) {

                return [
                    'announcement_id' => $announcement->id,
                    'user_id' => $id,
                    'is_seen' => 0,
                    'created_at' => now(),
                    'updated_at' => now(),
                ];
            })->toArray();

            DB::table('announcement_users')->insert($data);

            \Log::channel('fcm_notification')->info('Announcement Users Inserted', [
                'total_users' => count($data)
            ]);

            $tokens = User::whereNotNull('fcm_token')
                ->distinct()
                ->pluck('fcm_token')
                ->toArray();

            \Log::channel('fcm_notification')->info('FCM Tokens Fetched', [
                'total_tokens' => count($tokens)
            ]);
        }

        // =========================
        // Send Push Notification
        // =========================
        if (!empty($tokens)) {

            \Log::channel('fcm_notification')->info('Sending Push Notification');

            $this->sendPushNotification(
                $tokens,
                $request->title,
                $request->message
            );
        } else {

            \Log::channel('fcm_notification')->warning('No FCM Tokens Found');
        }

        \Log::channel('fcm_notification')->info('Announcement Process Completed');

        return back()->with('success', 'Announcement Created Successfully');
    }

    public function sendPushNotification($tokens, $title, $body){
        \Log::channel('fcm_notification')->info('================ FCM START ================');

        try {

            // ====================================
            // Firebase Credentials File
            // ====================================
            $credentialsPath = storage_path('app/firebase/firebase_credentials.json');

            \Log::channel('fcm_notification')->info('Firebase Path', [
                'path' => $credentialsPath
            ]);

            if (!file_exists($credentialsPath)) {

                \Log::channel('fcm_notification')->error('Firebase JSON file not found');

                return false;
            }

            $json = json_decode(file_get_contents($credentialsPath), true);

            \Log::channel('fcm_notification')->info('Firebase JSON Loaded');

            // ====================================
            // Firebase Details
            // ====================================
            $privateKey = str_replace("\\n", "\n", $json['private_key']);

            $clientEmail = $json['client_email'];

            $projectId = $json['project_id'];

            \Log::channel('fcm_notification')->info('Firebase Config', [
                'project_id' => $projectId,
                'client_email' => $clientEmail
            ]);

            // ====================================
            // OpenSSL Check
            // ====================================
            $keyResource = openssl_get_privatekey($privateKey);

            if (!$keyResource) {

                \Log::channel('fcm_notification')->error('Invalid Private Key');

                return false;
            }

            \Log::channel('fcm_notification')->info('Private Key Validated');

            // ====================================
            // Create JWT
            // ====================================
            $header = [
                'alg' => 'RS256',
                'typ' => 'JWT'
            ];

            $now = time();

            $payload = [
                'iss' => $clientEmail,
                'scope' => 'https://www.googleapis.com/auth/firebase.messaging',
                'aud' => 'https://oauth2.googleapis.com/token',
                'exp' => $now + 3600,
                'iat' => $now
            ];

            $base64UrlHeader = str_replace(
                ['+', '/', '='],
                ['-', '_', ''],
                base64_encode(json_encode($header))
            );

            $base64UrlPayload = str_replace(
                ['+', '/', '='],
                ['-', '_', ''],
                base64_encode(json_encode($payload))
            );

            $signatureInput = $base64UrlHeader . "." . $base64UrlPayload;

            $signature = '';

            $signed = openssl_sign(
                $signatureInput,
                $signature,
                $privateKey,
                'SHA256'
            );

            if (!$signed) {

                \Log::channel('fcm_notification')->error('JWT Signature Failed');

                return false;
            }

            \Log::channel('fcm_notification')->info('JWT Signed Successfully');

            $base64UrlSignature = str_replace(
                ['+', '/', '='],
                ['-', '_', ''],
                base64_encode($signature)
            );

            $jwt = $base64UrlHeader . "." . $base64UrlPayload . "." . $base64UrlSignature;

            \Log::channel('fcm_notification')->info('JWT Generated');

            // ====================================
            // OAuth Token Request
            // ====================================
            $tokenUrl = 'https://oauth2.googleapis.com/token';

            $postFields = http_build_query([
                'grant_type' => 'urn:ietf:params:oauth:grant-type:jwt-bearer',
                'assertion' => $jwt
            ]);

            $ch = curl_init();

            curl_setopt($ch, CURLOPT_URL, $tokenUrl);
            curl_setopt($ch, CURLOPT_POST, true);
            curl_setopt($ch, CURLOPT_POSTFIELDS, $postFields);
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

            curl_setopt($ch, CURLOPT_HTTPHEADER, [
                'Content-Type: application/x-www-form-urlencoded'
            ]);

            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
            curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);

            $response = curl_exec($ch);

            if (curl_errno($ch)) {

                \Log::channel('fcm_notification')->error('OAuth CURL Error', [
                    'error' => curl_error($ch)
                ]);
            }

            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);

            curl_close($ch);

            \Log::channel('fcm_notification')->info('OAuth Response', [
                'http_code' => $httpCode,
                'response' => $response
            ]);

            $responseData = json_decode($response, true);

            if (!isset($responseData['access_token'])) {

                \Log::channel('fcm_notification')->error('Access Token Not Generated', [
                    'response' => $responseData
                ]);

                return false;
            }

            $accessToken = $responseData['access_token'];

            \Log::channel('fcm_notification')->info('Access Token Generated Successfully');

            // ====================================
            // Send Notification
            // ====================================
            foreach ($tokens as $deviceToken) {

                \Log::channel('fcm_notification')->info('Sending Notification To Token', [
                    'token' => $deviceToken
                ]);

                $payload = [
                    "message" => [

                        "token" => $deviceToken,

                        "notification" => [
                            "title" => $title,
                            "body" => $body
                        ],

                        "data" => [
                            "click_action" => "FLUTTER_NOTIFICATION_CLICK"
                        ],

                        "android" => [
                            "priority" => "high"
                        ]
                    ]
                ];

                $url = "https://fcm.googleapis.com/v1/projects/{$projectId}/messages:send";

                $headers = [
                    'Authorization: Bearer ' . $accessToken,
                    'Content-Type: application/json',
                ];

                $ch = curl_init();

                curl_setopt($ch, CURLOPT_URL, $url);
                curl_setopt($ch, CURLOPT_POST, true);
                curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
                curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($payload));

                curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
                curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);

                $response = curl_exec($ch);

                if (curl_errno($ch)) {

                    \Log::channel('fcm_notification')->error('FCM CURL Error', [
                        'error' => curl_error($ch)
                    ]);
                }

                $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);

                curl_close($ch);

                \Log::channel('fcm_notification')->info('FCM Send Response', [
                    'http_code' => $httpCode,
                    'response' => $response
                ]);
            }

        } catch (\Exception $e) {

            \Log::channel('fcm_notification')->error('FCM Exception', [
                'message' => $e->getMessage(),
                'line' => $e->getLine(),
                'file' => $e->getFile()
            ]);
        }

        \Log::channel('fcm_notification')->info('================ FCM END ================');
    }
