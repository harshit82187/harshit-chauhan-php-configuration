// ============================================================
{
  console.log("\n--- Q18. Find pairs with given sum ---");
  function findPairs(arr, target) {
    const count = {};
    const pairs = [];
    for (let i = 0; i < arr.length; i++) {
      const need = target - arr[i];
      const times = count[need] || 0;
      for (let t = 0; t < times; t++) {
        pairs[pairs.length] = [need, arr[i]];
      }
      count[arr[i]] = (count[arr[i]] || 0) + 1; // check ke baad badhao
    }
    return pairs;
  }

