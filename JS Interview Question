{
  console.log("\n--- Q3. Anagram: words ke anagram groups banao ---");
  const LOWER = "abcdefghijklmnopqrstuvwxyz";

  // "eat" -> "1#0#0#0#1#...": har letter ki ginti
  function signature(word) {
    const count = {};
    for (let i = 0; i < word.length; i++) {
      count[word[i]] = (count[word[i]] || 0) + 1;
    }
    let key = "";
    for (let i = 0; i < LOWER.length; i++) {
      key += (count[LOWER[i]] || 0) + "#";
    }
    return key;
  }

  function groupAnagrams(words) {
    const groupIndex = {}; // signature -> result me group ka index
    const result = [];
    for (let i = 0; i < words.length; i++) {
      const key = signature(words[i]);
      if (groupIndex[key] === undefined) {
        groupIndex[key] = result.length;
        result[result.length] = [];
      }
      const group = result[groupIndex[key]];
      group[group.length] = words[i];
    }
    return result;
  }

  console.log(groupAnagrams(["eat", "tea", "tan", "ate", "nat", "bat"]));
  // [ [ 'eat', 'tea', 'ate' ], [ 'tan', 'nat' ], [ 'bat' ] ]
  console.log(groupAnagrams(["listen", "silent", "enlist", "google"]));
  // [ [ 'listen', 'silent', 'enlist' ], [ 'google' ] ]
  console.log(groupAnagrams([])); // []
}

// ============================================================
// Q4. Count characters (letters, digits, spaces, special)
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q4. Count characters (letters, digits, spaces, special) ---");
  function countCharacters(str) {
    const result = { total: 0, letters: 0, digits: 0, spaces: 0, special: 0 };
    for (let i = 0; i < str.length; i++) {
      const ch = str[i];
      result.total++;
      if ((ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z")) {
        result.letters++;
      } else if (ch >= "0" && ch <= "9") {
        result.digits++;
      } else if (ch === " ") {
        result.spaces++;
      } else {
        result.special++;
      }
    }
    return result;
  }

  // Bonus: .length ke bina length
  function stringLength(str) {
    let count = 0;
    while (str[count] !== undefined) {
      count++;
    }
    return count;
  }

  console.log(countCharacters("Hello World 2026!"));
  // { total: 17, letters: 10, digits: 4, spaces: 2, special: 1 }
  console.log(stringLength("JavaScript")); // 10
  console.log(countCharacters(""));
  // { total: 0, letters: 0, digits: 0, spaces: 0, special: 0 }
}

// ============================================================
// Q5. Character frequency
// Time: O(n)  |  Space: O(k) (k = alag-alag characters)
// ============================================================
{
  console.log("\n--- Q5. Character frequency ---");
  const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const LOWER = "abcdefghijklmnopqrstuvwxyz";

  // toLowerCase() ki jagah
  function toLowerChar(ch) {
    for (let i = 0; i < UPPER.length; i++) {
      if (UPPER[i] === ch) return LOWER[i];
    }
    return ch;
  }

  function charFrequency(str, ignoreCase) {
    const freq = {};
    for (let i = 0; i < str.length; i++) {
      let ch = str[i];
      if (ch === " ") continue; // space nahi ginna
      if (ignoreCase) ch = toLowerChar(ch);
      freq[ch] = (freq[ch] || 0) + 1;
    }
    return freq;
  }

  function mostFrequentChar(str) {
    const freq = charFrequency(str, true);
    let best = null;
    let bestCount = 0;
    for (const ch in freq) { // Object.keys() ki jagah
      if (freq[ch] > bestCount) {
        bestCount = freq[ch];
        best = ch;
      }
    }
    return { char: best, count: bestCount };
  }

  console.log(charFrequency("banana"));         // { b: 1, a: 3, n: 2 }
  console.log(charFrequency("Aa Bb", true));    // { a: 2, b: 2 }
  console.log(mostFrequentChar("Programming")); // { char: 'r', count: 2 }
}

