  function chunk(arr, size) {
    if (size <= 0) return [];

    const result = [];
    let current = [];
    for (let i = 0; i < arr.length; i++) {
      current[current.length] = arr[i];
      if (current.length === size) {
        result[result.length] = current;
        current = [];
      }
