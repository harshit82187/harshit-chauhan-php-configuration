// ============================================================
// Q10. Reverse words
// Time: O(n)  |  Space: O(n)
// ============================================================
{
  console.log("\n--- Q10. Reverse words ---");
  function isSpace(ch) {
    return ch === " " || ch === "\t" || ch === "\n";
  }

  // split(" ") ki jagah: extra spaces ignore ho jaate hain
  function getWords(str) {
    const words = [];
    let word = "";
    for (let i = 0; i < str.length; i++) {
      if (isSpace(str[i])) {
        if (word !== "") {
          words[words.length] = word; // push() ki jagah
          word = "";
        }
      } else {
        word += str[i];
      }
    }
    if (word !== "") words[words.length] = word;
    return words;
  }

  function reverseWords(str) {
    const words = getWords(str);
    let result = "";
    for (let i = words.length - 1; i >= 0; i--) {
      result += words[i];
      if (i > 0) result += " ";
    }
    return result;
  }

  function reverseEachWord(str) {
    const words = getWords(str);
    let result = "";
    for (let i = 0; i < words.length; i++) {
      let reversed = "";
      for (let j = words[i].length - 1; j >= 0; j--) {
        reversed += words[i][j];
      }
      result += reversed;
      if (i < words.length - 1) result += " ";
    }
    return result;
  }

  console.log(reverseWords("I love JavaScript"));             // JavaScript love I
  console.log("[" + reverseWords("  hello   world  ") + "]"); // [world hello]
  console.log(reverseEachWord("I love coding"));              // I evol gnidoc
}

