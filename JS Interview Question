// Q25. Find duplicates without built-in methods
// Time: Tarika 1: O(n²), tarika 2: O(n)  |  Space: Tarika 1: O(k), tarika 2: O(n) copy (original badal sakte ho to O(1))
// ============================================================
{
  console.log("\n--- Q25. Find duplicates without built-in methods ---");
  // Tarika 1: nested loops, koi object / Set nahi
  function findDuplicatesNoBuiltIn(arr) {
    const result = [];
    for (let i = 0; i < arr.length; i++) {
      let alreadyAdded = false;
      for (let k = 0; k < result.length; k++) {
        if (result[k] === arr[i]) {
          alreadyAdded = true;
          break;
        }
      }
      if (alreadyAdded) continue;

      for (let j = i + 1; j < arr.length; j++) {
        if (arr[j] === arr[i]) {
          result[result.length] = arr[i];
          break;
        }
      }
    }
    return result;
  }

  // Tarika 2: values 1..n ke beech hon to index par sign se mark karo
  function findDuplicatesInRange(input) {
    const arr = [];
    for (let i = 0; i < input.length; i++) arr[i] = input[i]; // copy

    const result = [];
    for (let i = 0; i < arr.length; i++) {
      let value = arr[i];
      if (value < 0) value = -value; // Math.abs ki jagah
      const idx = value - 1;
      if (arr[idx] < 0) {
        result[result.length] = value; // pehle mark ho chuka tha
      } else {
        arr[idx] = -arr[idx];
      }
    }
    return result;
  }

  console.log(findDuplicatesNoBuiltIn([1, 2, 3, 2, 4, 3, 3]));  // [ 2, 3 ]
  console.log(findDuplicatesNoBuiltIn([5, 6, 7]));              // []
  console.log(findDuplicatesInRange([4, 3, 2, 7, 8, 2, 3, 1])); // [ 2, 3 ]
}





