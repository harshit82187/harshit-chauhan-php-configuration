// ============================================================
// Q7. First repeating character
// Time: O(n)  |  Space: O(k)
// ============================================================
{
  console.log("\n--- Q7. First repeating character ---");
  // Definition 1: jo character sabse pehle dobara mile
  function firstRepeatingSeen(str) {
    const seen = {};
    for (let i = 0; i < str.length; i++) {
      if (seen[str[i]] === true) {
        return str[i];
      }
      seen[str[i]] = true;
    }
    return null;
  }

  // Definition 2: pehli position wala character jo kahin bhi repeat ho
  function firstRepeatingByPosition(str) {
    const count = {};
    for (let i = 0; i < str.length; i++) {
      count[str[i]] = (count[str[i]] || 0) + 1;
    }
    for (let i = 0; i < str.length; i++) {
      if (count[str[i]] > 1) return str[i];
    }
    return null;
  }

  console.log(firstRepeatingSeen("abcbad"));       // b
  console.log(firstRepeatingByPosition("abcbad")); // a
  console.log(firstRepeatingSeen("abc"));          // null
}

