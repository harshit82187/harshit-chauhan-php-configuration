// Q20. Find missing number (1 se n tak)
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q20. Find missing number (1 se n tak) ---");
  // Tarika 1: sum formula
  function findMissing(arr) {
    const n = arr.length + 1;
    let sum = 0;
    for (let i = 0; i < arr.length; i++) {
      sum += arr[i];
    }
    return (n * (n + 1)) / 2 - sum;
  }

  // Tarika 2: XOR
  function findMissingXor(arr) {
    const n = arr.length + 1;
    let xor = 0;
    for (let i = 1; i <= n; i++) {
      xor = xor ^ i;
    }
    for (let i = 0; i < arr.length; i++) {
      xor = xor ^ arr[i];
    }
    return xor;
  }

  console.log(findMissing([1, 2, 4, 5, 6]));  // 3
  console.log(findMissing([1, 2, 3, 4]));     // 5
  console.log(findMissingXor([2, 3, 1, 5]));  // 4
  console.log(findMissingXor([1]));           // 2
}

// ============================================================
// Q21. Find continuous subarray with given sum
// Time: O(n)  |  Space: Sliding window: O(1), prefix sum: O(n)
// ============================================================
{
  console.log("\n--- Q21. Find continuous subarray with given sum ---");
  // Sirf positive numbers: sliding window
  function subarrayWithSum(arr, target) {
    let start = 0;
    let sum = 0;
    for (let end = 0; end < arr.length; end++) {
      sum += arr[end];
      while (sum > target && start < end) {
        sum -= arr[start];
        start++;
      }
      if (sum === target) {
        return { start, end };
      }
    }
    return null;
  }

  // Negative numbers ke saath: prefix sum
  function subarrayWithSumAny(arr, target) {
    const firstIndex = { 0: -1 }; // prefix sum -> pehla index
    let prefix = 0;
    for (let i = 0; i < arr.length; i++) {
      prefix += arr[i];
      if (firstIndex[prefix - target] !== undefined) {
        return { start: firstIndex[prefix - target] + 1, end: i };
      }
      if (firstIndex[prefix] === undefined) {
        firstIndex[prefix] = i;
      }
    }
    return null;
  }

  // slice() ki jagah
  function getRange(arr, start, end) {
    const part = [];
    for (let i = start; i <= end; i++) {
      part[part.length] = arr[i];
    }
    return part;
  }

  const nums = [1, 4, 20, 3, 10, 5];
  const r = subarrayWithSum(nums, 33);
  console.log(r);                                  // { start: 2, end: 4 }
  console.log(getRange(nums, r.start, r.end));     // [ 20, 3, 10 ]
  console.log(subarrayWithSum([1, 2, 3], 10));     // null
  console.log(subarrayWithSumAny([10, 2, -2, -20, 10], -10)); // { start: 0, end: 3 }
}

// ============================================================
// Q22. Find maximum sum subarray (Kadane's algorithm)
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q22. Find maximum sum subarray (Kadane's algorithm) ---");
  function maxSubarray(arr) {
    if (arr.length === 0) return null;

    let best = arr[0];
    let current = arr[0];
    let start = 0;
    let bestStart = 0;
    let bestEnd = 0;

    for (let i = 1; i < arr.length; i++) {
      if (current + arr[i] < arr[i]) {
        current = arr[i]; // naya subarray yahin se
        start = i;
      } else {
        current = current + arr[i];
      }
      if (current > best) {
        best = current;
        bestStart = start;
        bestEnd = i;
      }
    }
    return { sum: best, start: bestStart, end: bestEnd };
  }

  console.log(maxSubarray([-2, 1, -3, 4, -1, 2, 1, -5, 4]));
  // { sum: 6, start: 3, end: 6 }  -> [4, -1, 2, 1]
  console.log(maxSubarray([-3, -1, -2])); // { sum: -1, start: 1, end: 1 }
  console.log(maxSubarray([5]));          // { sum: 5, start: 0, end: 0 }
}

// ============================================================
// Q23. Sort array without sort()
// Time: Bubble: O(n²) (sorted par O(n)), merge: O(n log n)  |  Space: Bubble: O(n) copy, merge: O(n)
// ============================================================
{
  console.log("\n--- Q23. Sort array without sort() ---");
  // Tarika 1: Bubble sort
  function bubbleSort(input) {
    const arr = [];
    for (let i = 0; i < input.length; i++) arr[i] = input[i]; // copy

    for (let i = 0; i < arr.length - 1; i++) {
      let swapped = false;
      for (let j = 0; j < arr.length - 1 - i; j++) {
        if (arr[j] > arr[j + 1]) {
          const temp = arr[j];
          arr[j] = arr[j + 1];
          arr[j + 1] = temp;
          swapped = true;
        }
      }
      if (!swapped) break; // already sorted
    }
    return arr;
  }

  // Tarika 2: Merge sort
  function mergeSort(arr) {
    if (arr.length <= 1) return arr;
    const mid = (arr.length - (arr.length % 2)) / 2; // Math.floor ki jagah
    const left = [];
    const right = [];
    for (let i = 0; i < mid; i++) left[left.length] = arr[i];
    for (let i = mid; i < arr.length; i++) right[right.length] = arr[i];
    return merge(mergeSort(left), mergeSort(right));
  }

  function merge(a, b) {
    const result = [];
    let i = 0;
    let j = 0;
    while (i < a.length && j < b.length) {
      if (a[i] <= b[j]) result[result.length] = a[i++];
      else result[result.length] = b[j++];
    }
    while (i < a.length) result[result.length] = a[i++];
    while (j < b.length) result[result.length] = b[j++];
    return result;
  }

  console.log(bubbleSort([5, 1, 4, 2, 8]));   // [ 1, 2, 4, 5, 8 ]
  console.log(mergeSort([38, 27, 43, 3, 9])); // [ 3, 9, 27, 38, 43 ]
  console.log(mergeSort([-1, 5, -10, 0]));    // [ -10, -1, 0, 5 ]
  // Descending ke liye: a[i] >= b[j]
}

