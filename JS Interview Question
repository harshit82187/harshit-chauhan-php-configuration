// Q12. Find shortest word
// Time: O(n)  |  Space: O(n)
// ============================================================
{
  console.log("\n--- Q12. Find shortest word ---");
  function isSpace(ch) {
    return ch === " " || ch === "\t" || ch === "\n";
  }

  // split(" ") ki jagah: extra spaces ignore ho jaate hain
  function getWords(str) {
    const words = [];
    let word = "";
    for (let i = 0; i < str.length; i++) {
      if (isSpace(str[i])) {
        if (word !== "") {
          words[words.length] = word; // push() ki jagah
          word = "";
        }
      } else {
        word += str[i];
      }
    }
    if (word !== "") words[words.length] = word;
    return words;
  }

  function shortestWords(str) {
    const words = getWords(str);
    if (words.length === 0) return [];

    let minLen = words[0].length;
    for (let i = 1; i < words.length; i++) {
      if (words[i].length < minLen) minLen = words[i].length;
    }

    const result = [];
    for (let i = 0; i < words.length; i++) {
      if (words[i].length === minLen) {
        result[result.length] = words[i];
      }
    }
    return result;
  }

  console.log(shortestWords("I love JavaScript")); // [ 'I' ]
  console.log(shortestWords("cat is on the mat")); // [ 'is', 'on' ]
  console.log(shortestWords(""));                  // []
}

// ============================================================
// Q13. Check if two strings are anagrams
// Time: O(n + m)  |  Space: O(k)
// ============================================================
{
  console.log("\n--- Q13. Check if two strings are anagrams ---");
  const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const LOWER = "abcdefghijklmnopqrstuvwxyz";

  // toLowerCase() ki jagah
  function toLowerChar(ch) {
    for (let i = 0; i < UPPER.length; i++) {
      if (UPPER[i] === ch) return LOWER[i];
    }
    return ch;
  }

  function isAnagram(a, b) {
    const count = {};
    let remaining = 0;

    for (let i = 0; i < a.length; i++) {
      if (a[i] === " ") continue;
      const ch = toLowerChar(a[i]);
      count[ch] = (count[ch] || 0) + 1;
      remaining++;
    }

    for (let i = 0; i < b.length; i++) {
      if (b[i] === " ") continue;
      const ch = toLowerChar(b[i]);
      if (!count[ch]) return false; // letter tha hi nahi, ya zyada baar aaya
      count[ch]--;
      remaining--;
    }
    return remaining === 0; // a ke saare letters use hue?
  }

  console.log(isAnagram("listen", "silent"));        // true
  console.log(isAnagram("Dormitory", "Dirty room")); // true
  console.log(isAnagram("hello", "world"));          // false
  console.log(isAnagram("aab", "ab"));               // false
}

// ============================================================
// Q14. Find occurrence of a substring
// Time: O(n x m)  |  Space: O(1) (indexes array ke alawa)
// ============================================================
{
  console.log("\n--- Q14. Find occurrence of a substring ---");
  // Saari starting positions (overlap ke saath)
  function findAllIndexes(text, word) {
    const indexes = [];
    if (word.length === 0) return indexes;

    for (let i = 0; i + word.length <= text.length; i++) {
      let match = true;
      for (let j = 0; j < word.length; j++) {
        if (text[i + j] !== word[j]) {
          match = false;
          break;
        }
      }
      if (match) indexes[indexes.length] = i;
    }
    return indexes;
  }

  // Bina overlap ke ginti
  function countNonOverlapping(text, word) {
    if (word.length === 0) return 0;
    let count = 0;
    let i = 0;
    while (i + word.length <= text.length) {
      let match = true;
      for (let j = 0; j < word.length; j++) {
        if (text[i + j] !== word[j]) {
          match = false;
          break;
        }
      }
      if (match) {
        count++;
        i += word.length; // match ke baad aage kood jao
      } else {
        i++;
      }
    }
    return count;
  }

  console.log(findAllIndexes("abababa", "aba"));        // [ 0, 2, 4 ]
  console.log(findAllIndexes("abababa", "aba").length); // 3
  console.log(countNonOverlapping("abababa", "aba"));   // 2
  console.log(findAllIndexes("hello", "xyz"));          // []
}

// ============================================================
// Q15. Remove spaces
// Time: O(n)  |  Space: O(n)
// ============================================================
{
  console.log("\n--- Q15. Remove spaces ---");
  function isSpace(ch) {
    return ch === " " || ch === "\t" || ch === "\n";
  }

  // 1. Saare spaces hatao
  function removeAllSpaces(str) {
    let result = "";
    for (let i = 0; i < str.length; i++) {
      if (!isSpace(str[i])) result += str[i];
    }
    return result;
  }

  // 2. trim() ki jagah
  function myTrim(str) {
    let start = 0;
    let end = str.length - 1;
    while (start <= end && isSpace(str[start])) start++;
    while (end >= start && isSpace(str[end])) end--;

    let result = "";
    for (let i = start; i <= end; i++) result += str[i];
    return result;
  }

  // 3. Trim + beech ke extra spaces ko ek space
  function normalizeSpaces(str) {
    let result = "";
    let pendingSpace = false;
    for (let i = 0; i < str.length; i++) {
      if (isSpace(str[i])) {
        pendingSpace = true;
      } else {
        if (pendingSpace && result !== "") result += " ";
        result += str[i];
        pendingSpace = false;
      }
    }
    return result;
  }

  const text = "  Hello   World  ";
  console.log(removeAllSpaces(text));             // HelloWorld
  console.log("[" + myTrim(text) + "]");          // [Hello   World]
  console.log("[" + normalizeSpaces(text) + "]"); // [Hello World]
  console.log("[" + myTrim("     ") + "]");       // []
}

