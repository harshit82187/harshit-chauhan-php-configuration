// ============================================================
// Q15. Count digits
// Time: O(d) (d = digits)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q15. Count digits ---");
  function countDigits(num) {
    if (num === 0) return 1;
    if (num < 0) num = -num; // Math.abs ki jagah

    let count = 0;
    while (num > 0) {
      num = (num - (num % 10)) / 10; // aakhri digit hata do
      count++;
    }
    return count;
  }

  // Bonus: digits ka sum
  function sumOfDigits(num) {
    if (num < 0) num = -num;
    let sum = 0;
    while (num > 0) {
      const digit = num % 10;
      sum += digit;
      num = (num - digit) / 10;
    }
    return sum;
  }

  console.log(countDigits(12345)); // 5
  console.log(countDigits(0));     // 1
  console.log(countDigits(-987));  // 3
  console.log(countDigits(7));     // 1
  console.log(sumOfDigits(1234));  // 10
}













