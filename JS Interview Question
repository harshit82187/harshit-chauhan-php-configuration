// ============================================================
// Q1. Find largest number
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q1. Find largest number ---");
  function findLargest(arr) {
    if (arr.length === 0) return null;

    let largest = arr[0];
    for (let i = 1; i < arr.length; i++) {
      if (arr[i] > largest) {
        largest = arr[i];
      }
    }
    return largest;
  }

  console.log(findLargest([3, 7, 2, 9, 4]));  // 9
  console.log(findLargest([-5, -2, -8, -1])); // -1
  console.log(findLargest([42]));             // 42
  console.log(findLargest([]));               // null
}

// ============================================================
// Q2. Find smallest number
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q2. Find smallest number ---");
  function findSmallest(arr) {
    if (arr.length === 0) return null;

    let smallest = arr[0];
    for (let i = 1; i < arr.length; i++) {
      if (arr[i] < smallest) {
        smallest = arr[i];
      }
    }
    return smallest;
  }

  console.log(findSmallest([3, 7, 2, 9, 4]));  // 2
  console.log(findSmallest([-5, -2, -8, -1])); // -8
  console.log(findSmallest([10]));             // 10
  console.log(findSmallest([]));               // null
}

// ============================================================
// Q3. Find second largest number
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q3. Find second largest number ---");
  function findSecondLargest(arr) {
    let first = -Infinity;
    let second = -Infinity;

    for (let i = 0; i < arr.length; i++) {
      const num = arr[i];
      if (num > first) {
        second = first; // purana largest ab second hai
        first = num;
      } else if (num > second && num !== first) {
        second = num;
      }
    }
    return second === -Infinity ? null : second;
  }

  console.log(findSecondLargest([10, 5, 20, 8]));  // 10
  console.log(findSecondLargest([20, 20, 10]));    // 10
  console.log(findSecondLargest([-1, -5, -3]));    // -3
  console.log(findSecondLargest([7, 7, 7]));       // null
  console.log(findSecondLargest([5]));             // null
}

