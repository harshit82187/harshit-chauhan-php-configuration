// Q10. Find frequency of elements
// Time: O(n)  |  Space: O(k) (k = alag-alag values)
// ============================================================
{
  console.log("\n--- Q10. Find frequency of elements ---");
  function frequency(arr) {
    const freq = {};
    for (let i = 0; i < arr.length; i++) {
      const value = arr[i];
      if (freq[value] === undefined) {
        freq[value] = 0;
      }
      freq[value]++;
    }
    return freq;
  }

  function mostFrequent(arr) {
    const freq = frequency(arr);
    let best = null;
    let bestCount = 0;
    for (let i = 0; i < arr.length; i++) {
      if (freq[arr[i]] > bestCount) {
        bestCount = freq[arr[i]];
        best = arr[i];
      }
    }
