// ============================================================
// Q1. Reverse string
// Time: Loop / two pointers: O(n), recursion: O(n²)  |  Space: O(n)
// ============================================================
{
  console.log("\n--- Q1. Reverse string ---");
  // Tarika 1: loop
  function reverseString(str) {
    let reversed = "";
    for (let i = str.length - 1; i >= 0; i--) {
      reversed += str[i];
    }
    return reversed;
  }

  // Tarika 2: recursion
  function reverseRecursive(str) {
    if (str.length <= 1) return str;
    let rest = "";
    for (let i = 1; i < str.length; i++) rest += str[i]; // slice(1) ki jagah
    return reverseRecursive(rest) + str[0];
  }

  // Tarika 3: two pointers
  function reverseTwoPointers(str) {
    const chars = [];
    for (let i = 0; i < str.length; i++) chars[i] = str[i];

    let left = 0;
    let right = chars.length - 1;
    while (left < right) {
      const temp = chars[left];
      chars[left] = chars[right];
      chars[right] = temp;
      left++;
      right--;
    }

    let result = "";
    for (let i = 0; i < chars.length; i++) result += chars[i]; // join() ki jagah
    return result;
  }

  console.log(reverseString("hello"));         // olleh
  console.log(reverseRecursive("JavaScript")); // tpircSavaJ
  console.log(reverseTwoPointers("race car")); // rac ecar
  console.log(reverseString("") === "");       // true
}

// ============================================================
// Q2. Palindrome (case aur symbols ignore karke)
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q2. Palindrome (case aur symbols ignore karke) ---");
  const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const LOWER = "abcdefghijklmnopqrstuvwxyz";

  // toLowerCase() ki jagah
  function toLowerChar(ch) {
    for (let i = 0; i < UPPER.length; i++) {
      if (UPPER[i] === ch) return LOWER[i];
    }
    return ch;
  }

  function isAlphaNumeric(ch) {
    return (ch >= "a" && ch <= "z") ||
           (ch >= "A" && ch <= "Z") ||
           (ch >= "0" && ch <= "9");
  }

  function isPalindrome(str) {
    let left = 0;
    let right = str.length - 1;
    while (left < right) {
      // space, comma jaise characters skip karo
      while (left < right && !isAlphaNumeric(str[left])) left++;
      while (left < right && !isAlphaNumeric(str[right])) right--;

      if (toLowerChar(str[left]) !== toLowerChar(str[right])) {
        return false;
      }
      left++;
      right--;
    }
    return true;
  }

  console.log(isPalindrome("madam"));                          // true
  console.log(isPalindrome("Madam"));                          // true
  console.log(isPalindrome("A man, a plan, a canal: Panama")); // true
  console.log(isPalindrome("hello"));                          // false
  console.log(isPalindrome(""));                               // true
}

