// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q4. Find second smallest number ---");
  function findSecondSmallest(arr) {
    let first = Infinity;
    let second = Infinity;

    for (let i = 0; i < arr.length; i++) {
      const num = arr[i];
      if (num < first) {
        second = first;
        first = num;
      } else if (num < second && num !== first) {
        second = num;
      }
    }
    return second === Infinity ? null : second;
  }

  console.log(findSecondSmallest([10, 5, 20, 8])); // 8
  console.log(findSecondSmallest([1, 1, 4]));      // 4
  console.log(findSecondSmallest([-1, -5, -3]));   // -3
  console.log(findSecondSmallest([3, 3]));         // null
}

// ============================================================
// Q5. Reverse an array
// Time: O(n)  |  Space: Naya array: O(n), in-place: O(1)
// ============================================================
{
  console.log("\n--- Q5. Reverse an array ---");
  // Tarika 1: naya array (original nahi badlega)
  function reverseArray(arr) {
    const result = [];
    for (let i = arr.length - 1; i >= 0; i--) {
      result[result.length] = arr[i]; // push() ki jagah
    }
    return result;
  }

  // Tarika 2: in-place (original hi ulta ho jaayega)
  function reverseInPlace(arr) {
    let left = 0;
    let right = arr.length - 1;
    while (left < right) {
      const temp = arr[left];
      arr[left] = arr[right];
      arr[right] = temp;
      left++;
      right--;
    }
    return arr;
  }

  const nums = [1, 2, 3, 4, 5];
  console.log(reverseArray(nums));   // [ 5, 4, 3, 2, 1 ]
  console.log(nums);                 // [ 1, 2, 3, 4, 5 ]  (original same)
  console.log(reverseInPlace([10, 20, 30, 40])); // [ 40, 30, 20, 10 ]
  console.log(reverseArray([]));     // []
}

// ============================================================
// Q6. Reverse a string
// Time: O(n)  |  Space: O(n)
// ============================================================
{
  console.log("\n--- Q6. Reverse a string ---");
  function reverseString(str) {
    let reversed = "";
    for (let i = str.length - 1; i >= 0; i--) {
      reversed += str[i];
    }
    return reversed;
  }

  console.log(reverseString("hello"));        // "olleh"
  console.log(reverseString("JavaScript"));   // "tpircSavaJ"
  console.log(reverseString("a b c"));        // "c b a"
  console.log(reverseString(""));             // ""
}

// ============================================================
// Q7. Check palindrome (string aur number)
// Time: String: O(n), Number: O(d) (d = digits)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q7. Check palindrome (string aur number) ---");
  const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const LOWER = "abcdefghijklmnopqrstuvwxyz";

  // toLowerCase() ki jagah apna helper
  function toLowerChar(ch) {
    for (let i = 0; i < UPPER.length; i++) {
      if (UPPER[i] === ch) return LOWER[i];
    }
    return ch;
  }

  function isPalindrome(str) {
    let left = 0;
    let right = str.length - 1;
    while (left < right) {
      if (toLowerChar(str[left]) !== toLowerChar(str[right])) {
        return false;
      }
      left++;
      right--;
    }
    return true;
  }

  function isNumberPalindrome(num) {
    if (num < 0) return false;
    const original = num;
    let reversed = 0;
    while (num > 0) {
      const digit = num % 10;
      reversed = reversed * 10 + digit;
      num = (num - digit) / 10; // Math.floor ki jagah
    }
    return original === reversed;
  }

  console.log(isPalindrome("madam"));    // true
  console.log(isPalindrome("Madam"));    // true
  console.log(isPalindrome("hello"));    // false
  console.log(isNumberPalindrome(121));  // true
  console.log(isNumberPalindrome(123));  // false
  console.log(isNumberPalindrome(-121)); // false
}

// ============================================================
// Q8. Check even / odd
// Time: O(1)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q8. Check even / odd ---");
  function checkEvenOdd(num) {
    if (num % 2 === 0) {
      return "Even";
    }
    return "Odd"; // -3 % 2 === -1 hota hai, isliye === 1 check nahi kiya
  }

  // Bitwise tarika
  function isEvenBitwise(num) {
    return (num & 1) === 0;
  }

  console.log(checkEvenOdd(4));   // "Even"
  console.log(checkEvenOdd(7));   // "Odd"
  console.log(checkEvenOdd(0));   // "Even"
  console.log(checkEvenOdd(-3));  // "Odd"
  console.log(isEvenBitwise(10)); // true
  console.log(isEvenBitwise(-3)); // false
}

