// Q24. Remove duplicates without Set
// Time: Tarika 1: O(n²), tarika 2: O(n)  |  Space: Tarika 1: O(n), tarika 2: O(1)
// ============================================================
{
  console.log("\n--- Q24. Remove duplicates without Set ---");
  // Tarika 1: sirf loops
  function removeDuplicatesNoSet(arr) {
    const result = [];
    for (let i = 0; i < arr.length; i++) {
      let found = false;
      for (let j = 0; j < result.length; j++) { // includes() ki jagah
        if (result[j] === arr[i]) {
          found = true;
          break;
        }
      }
      if (!found) {
        result[result.length] = arr[i];
      }
    }
    return result;
  }

  // Tarika 2: sorted array, in-place
  function removeDuplicatesSorted(arr) {
    if (arr.length === 0) return arr;
    let write = 1;
    for (let read = 1; read < arr.length; read++) {
      if (arr[read] !== arr[write - 1]) {
        arr[write] = arr[read];
        write++;
      }
    }
    arr.length = write; // baaki hissa hata do
    return arr;
  }

  console.log(removeDuplicatesNoSet([1, 2, 2, 3, 1, 4])); // [ 1, 2, 3, 4 ]
  console.log(removeDuplicatesNoSet(["a", "A", "a"]));    // [ 'a', 'A' ]
  console.log(removeDuplicatesSorted([1, 1, 2, 3, 3, 3])); // [ 1, 2, 3 ]
}

