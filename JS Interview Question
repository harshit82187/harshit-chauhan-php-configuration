// ============================================================
// Q19. Two Sum (indices return karo)
// Time: O(n)  |  Space: O(n), sorted: O(1)
// ============================================================
{
  console.log("\n--- Q19. Two Sum (indices return karo) ---");
  function twoSum(nums, target) {
    const seenAt = {}; // value -> index
    for (let i = 0; i < nums.length; i++) {
      const need = target - nums[i];
      if (seenAt[need] !== undefined) {
        return [seenAt[need], i];
      }
      seenAt[nums[i]] = i;
    }
    return null;
  }

  // Sorted array ke liye: two pointers
  function twoSumSorted(nums, target) {
    let left = 0;
    let right = nums.length - 1;
    while (left < right) {
      const sum = nums[left] + nums[right];
      if (sum === target) return [left, right];
      if (sum < target) left++;
      else right--;
    }
    return null;
  }

  console.log(twoSum([2, 7, 11, 15], 9));         // [ 0, 1 ]
  console.log(twoSum([3, 2, 4], 6));              // [ 1, 2 ]
  console.log(twoSum([3, 3], 6));                 // [ 0, 1 ]
  console.log(twoSum([1, 2], 7));                 // null
  console.log(twoSumSorted([1, 3, 4, 6, 9], 10)); // [ 0, 4 ]
}

