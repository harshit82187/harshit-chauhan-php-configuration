// Q8. Find maximum and minimum (ek hi loop me)
// Time: O(n)  |  Space: O(1)
// ============================================================
{
  console.log("\n--- Q8. Find maximum and minimum (ek hi loop me) ---");
  function findMaxMin(arr) {
    if (arr.length === 0) return null;

    let max = arr[0];
    let min = arr[0];
    for (let i = 1; i < arr.length; i++) {
      if (arr[i] > max) {
        max = arr[i];
      } else if (arr[i] < min) {
        min = arr[i];
      }
    }
    return { max, min };
  }

  console.log(findMaxMin([3, 9, 1, 7]));   // { max: 9, min: 1 }
  console.log(findMaxMin([-4, -9, -2]));   // { max: -2, min: -9 }
  console.log(findMaxMin([5]));            // { max: 5, min: 5 }
  console.log(findMaxMin([]));             // null
}

