// Q16. Capitalize first letter of every word
// Time: O(n)  |  Space: O(n)
// ============================================================
{
  console.log("\n--- Q16. Capitalize first letter of every word ---");
  const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const LOWER = "abcdefghijklmnopqrstuvwxyz";

  // toUpperCase() ki jagah
  function toUpperChar(ch) {
    for (let i = 0; i < LOWER.length; i++) {
      if (LOWER[i] === ch) return UPPER[i];
    }
    return ch;
  }

  // toLowerCase() ki jagah
  function toLowerChar(ch) {
    for (let i = 0; i < UPPER.length; i++) {
      if (UPPER[i] === ch) return LOWER[i];
    }
    return ch;
  }

  // lowerRest = true ho to title case (word ke baaki letters small)
  function capitalizeWords(str, lowerRest) {
    let result = "";
    let newWord = true;
    for (let i = 0; i < str.length; i++) {
      const ch = str[i];
      if (ch === " ") {
        result += ch;
        newWord = true;
      } else if (newWord) {
        result += toUpperChar(ch); // word ka pehla letter
        newWord = false;
      } else {
        result += lowerRest ? toLowerChar(ch) : ch;
      }
    }
    return result;
  }

  console.log(capitalizeWords("hello world from js")); // Hello World From Js
  console.log(capitalizeWords("i love  javaScript"));  // I Love  JavaScript
  console.log(capitalizeWords("hELLO wORLD", true));   // Hello World
  console.log(capitalizeWords("123abc test"));         // 123abc Test
}
