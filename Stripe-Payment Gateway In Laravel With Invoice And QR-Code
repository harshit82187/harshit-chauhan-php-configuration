use Illuminate\Support\Facades\DB;

class StripeController extends Controller
{
    public function stripePost(Request $request)
    {
        try {
            DB::beginTransaction();
            Stripe\Stripe::setApiKey(env('STRIPE_SECRET'));
    
            $user = Auth::user();
            $property = Property::findOrFail($request->property_id);
            $amount = (int) ($request->amount * 100); 
    
            $customer = $this->createStripeCustomer($request, $user);
            $charge = $this->chargeCustomer($amount, $customer, $user, $request);
            $invoiceNumber = $this->generateInvoiceNumber();
            $payment = $this->storePaymentInfo($charge, $user, $request, $invoiceNumber);
            $this->generateInvoiceAndSavePDF($payment, $user, $property, $invoiceNumber);
    
            // Send email to user and admin
            $this->sendEmail($user->email, $user, $payment, 'user');
            $this->sendEmail(View::shared('adminEmail'), $user, $payment, 'admin');
            DB::commit();
    
            return redirect()->route('thank.you', [
                'random_string' => Str::random(100),
                'transaction_id' => $payment->transaction_id,
            ])->with([
                'success' => 'Payment successful!',
                'amount' => $payment->amount,
                'reference_id' => $payment->reference_id
            ]);
    
        } catch (\Stripe\Exception\ApiErrorException $e) {
            Log::error("Stripe Error: " . $e->getMessage());
            Log::channel('stripe')->error("Stripe Error: " . $e->getMessage());
            DB::rollBack();
            return back()->with('error', 'Payment processing failed. Please try again.');
        } catch (\Exception $e) {
            Log::error("Error: " . $e->getMessage());
            Log::channel('stripe')->error("Error: " . $e->getMessage());
            DB::rollBack();
            return back()->with('error', 'Something went wrong. Please try again.');
        }
    }
    
    private function createStripeCustomer(Request $request, $user)
    {
        return Stripe\Customer::create([
            "address" => [
                "line1" => $request->address ?? 'N/A',
                "country" => $request->country,
            ],
            "email" => $user->email,
            "name" => $user->name,
            "phone" => $user->mobile,
            "source" => $request->stripeToken,
        ]);
    }
    
    private function chargeCustomer($amount, $customer, $user, $request)
    {
        return Stripe\Charge::create([
            "amount" => $amount,
            "currency" => "sar",
            "customer" => $customer->id,
            "description" => "Property Booking",
            "shipping" => [
                "name" => $user->name,
                "address" => [
                    "line1" => $user->address ?? 'N/A',
                ],
            ],
            'metadata' => [
                'property_id' => $request->property_id,
                'check_in' => $request->check_in,
                'check_out' => $request->check_out,
                'guests' => $request->guests,
                'children' => $request->children,
            ],
        ]);
    }
    
    private function generateInvoiceNumber()
    {
        return now()->format('Ym') . rand(100000, 999999);
    }
    
    private function storePaymentInfo($charge, $user, $request, $invoiceNumber)
    {
        $payment = new Payment();
        $payment->user_id = $user->id;
        $payment->invoice = $invoiceNumber;
        $payment->amount = $request->amount;
        $payment->currency = "sar";
        $payment->transaction_id = $charge->id;
        $payment->reference_id = $charge->balance_transaction; 
        $payment->status = $charge->status; 
        $payment->payment_method = $charge->payment_method; 
        $payment->receipt_url = $charge->receipt_url; 
        $payment->property_id = $request->property_id;
        $payment->check_in = $request->check_in;
        $payment->check_out = $request->check_out;
        $payment->guests = $request->guests;
        $payment->children = $request->children;
	$payment->created_at = now();
        $payment->updated_at = now();
        $payment->save();        
        return $payment;
    }
    
    private function generateInvoiceAndSavePDF($payment, $user, $property, $invoiceNumber)
    {
        $year = now()->year;
        $month = now()->format('M');
        $today = Carbon::now()->format('d-M-Y');
        $fileName = "invoice_{$invoiceNumber}.pdf";
        $directoryPath = public_path("property-booking/{$year}/{$month}");
    
        if (!File::exists($directoryPath)) {
            File::makeDirectory($directoryPath, 0777, true);
        }
    
        $qrCode = new QrCode(route('invoice.show', ['invoiceNumber' => $invoiceNumber]));
        $writer = new PngWriter();
        $qrCodeContent = $writer->write($qrCode)->getString();
    
        $qrCodeDirectory = public_path("qr-codes/{$year}/{$month}");
        if (!File::exists($qrCodeDirectory)) {
            File::makeDirectory($qrCodeDirectory, 0777, true);
        }
    
        $qrCodeFilePath = "{$qrCodeDirectory}/{$invoiceNumber}-qr.jpg"; 
        file_put_contents($qrCodeFilePath, $qrCodeContent);
    
        $payment->update([
            'qr_image' => "qr-codes/{$year}/{$month}/{$invoiceNumber}-qr.jpg",
        ]);
    
        // Generate PDF and save it
        $filePath = "{$directoryPath}/{$fileName}";
        $pdf = Pdf::loadView('pdf.stripe.invoice', compact('user', 'payment', 'property', 'today', 'qrCodeFilePath'))->setPaper('a4')->setOptions(['defaultFont' => 'arial', 'isRemoteEnabled'=> true]);
        $pdf->save($filePath);
    
        $payment->update([
            'invoice_pdf' => "property-booking/{$year}/{$month}/{$fileName}",
        ]);
        Log::channel('stripe')->info('Invoice PDF saved to ' . $filePath);
    }
    
     private function sendEmail($email, $user, $payment, $role)
    {
        try {
            $invoice = $payment->invoice;
            Log::channel('stripe')->info('Invoice No ' . $invoice);
            $subject = 'Property Booking Invoice #'.$invoice.' | '.\Carbon\Carbon::today()->format('d-M-Y').' | '.\Carbon\Carbon::now()->format('h:i A');
            Mail::to($email)->queue(new BookingInvoiceMail($user, $payment, $role, $subject));
            Log::channel('stripe')->info('Email sent to ' . $email);
        } catch (\Exception $mailException) {
            Log::channel('stripe')->error('Failed to send email to ' . $email . '. Error: ' . $mailException->getMessage());
        }
    }

