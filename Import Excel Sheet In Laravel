use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Validator;
use Illuminate\Validation\ValidationException;
use App\Exports\LeadExport;
use App\Imports\EnquiryImport;
use Maatwebsite\Excel\Facades\Excel;
use Maatwebsite\Excel\HeadingRowImport;



    public function manageImportLeadData(Request $req)
    {
        try {
            $req->validate([
                'excel_sheet' => 'required|file|mimes:xlsx,xls,csv',
            ]);

            $file = $req->file('excel_sheet');

            $expectedHeaders = ['name', 'email', 'phone']; 

            $import = new HeadingRowImport;
            $headingRow = $import->toArray($file)[0][0];

            $headers = array_values($headingRow);
            


            // Compare the headers with the expected ones
            if (!$this->validateHeaders($headers, $expectedHeaders)) {
                return back()->with('error', 'The Excel file does not have the correct headers.');
            }

            // Proceed with the import
            $user = Auth::user();
            Excel::import(new EnquiryImport($user), $file);
            return redirect()->back()->with('success', 'Leads imported successfully!');

        } catch (\Exception $e) {
            return back()->with('error', 'Warning: ' . $e->getMessage());
        }
    }

    private function validateHeaders($headers, $expectedHeaders)
    {
        // Trim and convert headers to lowercase
        $headers = array_map(function ($header) {
            return strtolower(trim($header));
        }, $headers);
        $expectedHeaders = array_map('strtolower', $expectedHeaders);
        // dd($headers, $expectedHeaders);
    
        return $headers === $expectedHeaders;
    }








