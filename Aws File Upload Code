use GuzzleHttp\Client;

function uploadToAWS($file, $folderName)
{
    try {
        $client = new Client(['timeout' => 60]);
        $imageName = time() . "-" . uniqid() . "." . $file->getClientOriginalExtension();
        $multipart = [
            [
                'name'     => 'upload_files[0]',
                'contents' => fopen($file->getRealPath(), 'r'),
                'filename' => $imageName,
            ],
            [
                'name'     => 'original_names[0]',
                'contents' => $imageName,
            ],
            [
                'name'     => 'folderName',
                'contents' => $folderName,
            ],
        ];
        $response = $client->request('POST', 'https://erp.pearlorganisation.in/public/api/S3/upload-file', [
            'multipart' => $multipart,
            'headers'   => ['Accept' => 'application/json']
        ]);
        $responseBody = json_decode($response->getBody()->getContents(), true);
        if (!empty($responseBody['file_urls'][0])) {
            return $responseBody['file_urls'][0]; // return uploaded URL
        }
    } catch (\Exception $e) {
        \Log::error("AWS Upload Error: " . $e->getMessage());
    }
    return null;
}
