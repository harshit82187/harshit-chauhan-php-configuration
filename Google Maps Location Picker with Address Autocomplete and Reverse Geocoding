Step :- 3 Script code 

  <script src="https://maps.googleapis.com/maps/api/js?key={{ config('app.google.apiKey') }}&libraries=places&callback=initAutocomplete" async defer></script>
 <script>
        let map;
        let marker;
        let geocoder;

        window.initAutocomplete = function () {

            geocoder = new google.maps.Geocoder();

            let defaultLocation = {
                lat: 28.6139,
                lng: 77.2090
            };

            map = new google.maps.Map(document.getElementById("map"), {
                center: defaultLocation,
                zoom: 13
            });

            marker = new google.maps.Marker({
                position: defaultLocation,
                map: map,
                draggable: true
            });

            // Marker drag hone par address fill karo
            google.maps.event.addListener(marker, "dragend", function(event) {

                let lat = event.latLng.lat();
                let lng = event.latLng.lng();

                $("#latitude").val(lat);
                $("#longitude").val(lng);

                reverseGeocode(lat, lng);
            });

            // Map click par marker move karo
            google.maps.event.addListener(map, "click", function(event) {

                marker.setPosition(event.latLng);

                let lat = event.latLng.lat();
                let lng = event.latLng.lng();

                $("#latitude").val(lat);
                $("#longitude").val(lng);

                reverseGeocode(lat, lng);
            });

            // Existing autocomplete
            let input = document.getElementById("address_one");

            const autocomplete = new google.maps.places.Autocomplete(input, {
                types: ["geocode"]
            });

            autocomplete.addListener("place_changed", function() {

                let place = autocomplete.getPlace();

                if (!place.geometry) return;

                let city = "";
                let postcode = "";

                place.address_components.forEach(function(component) {

                    let types = component.types;

                    if (types.includes("locality")) {
                        city = component.long_name;
                    }

                    if (!city && types.includes("administrative_area_level_2")) {
                        city = component.long_name;
                    }

                    if (types.includes("postal_code")) {
                        postcode = component.long_name;
                    }
                });

                let lat = place.geometry.location.lat();
                let lng = place.geometry.location.lng();

                $("#address_one").val(place.formatted_address);
                $("#city").val(city);
                $("#postcode").val(postcode);

                $("#latitude").val(lat);
                $("#longitude").val(lng);

                map.setCenter({
                    lat: lat,
                    lng: lng
                });

                marker.setPosition({
                    lat: lat,
                    lng: lng
                });

                map.setZoom(18);
            });
        };

        function reverseGeocode(lat, lng) {

            geocoder.geocode({
                location: {
                    lat: lat,
                    lng: lng
                }
            }, function(results, status) {

                if (status === "OK" && results[0]) {

                    let city = "";
                    let postcode = "";

                    results[0].address_components.forEach(function(component) {

                        let types = component.types;

                        if (types.includes("locality")) {
                            city = component.long_name;
                        }

                        if (!city && types.includes("administrative_area_level_2")) {
                            city = component.long_name;
                        }

                        if (types.includes("postal_code")) {
                            postcode = component.long_name;
                        }
                    });

                    $("#address_one").val(results[0].formatted_address);
                    $("#city").val(city);
                    $("#postcode").val(postcode);
                }
            });
        }
    </script>

