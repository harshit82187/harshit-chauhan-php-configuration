<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use App\Models\User;
use App\Models\Ticket;

use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Mail;
use Barryvdh\DomPDF\Facade\Pdf;
use Carbon\Carbon;
use Illuminate\Support\Facades\View;
use Illuminate\Support\Facades\File;


class SendPendingTicketDetails extends Command
{
    /**
     * The name and signature of the console command.
     *
     * @var string
     */
    protected $signature = 'send:pending-ticket-details';

    /**
     * The console command description.
     *
     * @var string
     */
    protected $description = 'Send Pending Ticket Details (Ticket No, Vendor Name, Subject and Description)';

    /**
     * Execute the console command.
     */
     public function handle()
    {
        try {
            // Fetch user details
            Log::channel('cron-job')->info('Pending Ticket Details  load successfully.');
            $tickets = Ticket::select('ticket_no', 'vendor_id','subject')->where('status','1')->get();
            if ($tickets->isEmpty()) {
                $this->info('No pending tickets to send.');
                Log::channel('cron-job')->info('No pending tickets to send.');

                return;
            }
            Log::channel('cron-job')->info('Tickets Data: ' . json_encode($tickets));
            $year = now()->year;
            $month = now()->format('M');
            $randomNumber = now()->format('Ym') . rand(100000, 999999);
            $fileName = "pending_ticket_{$randomNumber}.pdf";
            $directoryPath = public_path("cron-job/pending-ticket-pdfs/{$year}/{$month}");
            if (!File::exists($directoryPath)) {
                File::makeDirectory($directoryPath, 0777, true);
            }
            $filePath = "{$directoryPath}/{$fileName}";
            $adminEmail = View::shared('adminEmail');  
            Log::channel('cron-job')->info('About to generate PDF.');  
            $pdf = Pdf::loadView('mails.cron-job.pdf.pending-ticket-detail', compact('tickets','adminEmail'))->save($filePath);
            Log::channel('cron-job')->info('PDF generated and saved successfully.');
            $emailData = [
                'tickets' => $tickets,
            ];
            Log::channel('cron-job')->info('Sending email.');
            Mail::send('mails.cron-job.pending-ticket-detail', $emailData, function($message) use ($filePath) {
                $message->to('harshitk@pearlorganisation.com')->subject('Pending Ticket Details');
                $message->attach($filePath);
            }); 
            Log::channel('cron-job')->info('Email sent successfully.');
            $this->info('Pending Ticket Details  have been logged successfully.');
            Log::channel('cron-job')->info('Pending Ticket Details have been logged successfully.');

        } catch (\Exception $e) {
            Log::channel('cron-job')->error('Error sending Pending Ticket Details: ' . $e->getMessage());
            $this->error('Failed to send Pending Ticket Details. Check the logs for more information.');
        }
    }
}


Step :3 app/Console/Kernel.php 
<?php

namespace App\Console;

use Illuminate\Console\Scheduling\Schedule;
use Illuminate\Foundation\Console\Kernel as ConsoleKernel;

class Kernel extends ConsoleKernel
{
    /**
     * Define the application's command schedule.
     */
    protected function schedule(Schedule $schedule): void
    {
        $schedule->command('send:pending-ticket-details')->dailyAt('13:00');
    }

    /**
     * Register the commands for the application.
     */
    protected function commands(): void
    {
        $this->load(__DIR__.'/Commands');        
        require base_path('routes/console.php');
    }
}




