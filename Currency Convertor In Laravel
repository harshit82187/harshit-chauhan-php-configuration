<?php

namespace App\Http\Controllers\API;

use App\Http\Controllers\Controller;

use Illuminate\Http\Request;


use Illuminate\Support\Facades\View;
use Illuminate\Support\Facades\Validator;
use Illuminate\Validation\ValidationException;
use Illuminate\Support\Facades\File;

use App\Services\CurrencyService;

class CurrencyController extends Controller
{
    protected $currencyService;

    public function __construct(CurrencyService $currencyService){
        $this->currencyService = $currencyService;
    }

    public function convertAmount(Request $request)
    {
        $request->validate([
            'amount'   => 'required|numeric|min:0',
            'currency' => 'nullable|string',
            'country'  => 'nullable|string',
        ]);

        $amount = (float) $request->input('amount');
        $currency = $request->input('currency');

        if (!$currency) {
            $country = strtoupper($request->input('country', ''));
            $currency = $this->mapCountryToCurrency($country);
            if (!$currency) {
                return response()->json([
                    'success' => false,
                    'message' => 'Either currency or a supported country code is required.'
                ], 422);
            }
        }

        try {
            $res = $this->currencyService->convert($amount, $currency);

            return response()->json([
                'success'          => true,
                'base_currency'    => 'PKR',
                'base_amount'      => $amount,
                'target_currency'  => strtoupper($currency),
                'rate'             => $res['rate'],
                'converted_amount' => $res['converted'],
                'rates_date'       => $res['date'],
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => $e->getMessage()
            ], 500);
        }
    }

    /**
     * Minimal country -> currency mapping. Add more entries as needed.
     */
    private function mapCountryToCurrency(string $countryCode): ?string
    {
        $map = [
            'PK' => 'PKR',
            'IN' => 'INR',
            'US' => 'USD',
            'GB' => 'GBP',
            'EU' => 'EUR',
            'AE' => 'AED',
            'SA' => 'SAR',
            'CA' => 'CAD',
            'AU' => 'AUD',
            'NZ' => 'NZD',
            'SG' => 'SGD',
            'BD' => 'BDT',
            // add as needed...
        ];

        return $map[$countryCode] ?? null;
    }
}


