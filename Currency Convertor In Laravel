<?php
namespace App\Services;

use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Http;

class CurrencyService
{
    protected $base = 'pkr';
    protected $source = 'https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies';

    /**
     * Get cached rates (with date). Returns ['date' => 'YYYY-MM-DD', 'rates' => [...]]
     */

    public function convertFromPKR($amount, $toCurrency){
        if ($toCurrency === 'pkr') {
            return $amount;
        }

        $response = Http::get("https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/pkr.json");

        if ($response->failed()) {
            throw new \Exception("Currency API error");
        }

        $rates = $response->json()['pkr'];
        $rate = $rates[$toCurrency] ?? null;

        if (!$rate) {
            throw new \Exception("Currency not supported: {$toCurrency}");
        }

        return round($amount * $rate, 2);
    }

    public function getRates(): array
    {
        return Cache::remember('currency_rates_pkr', 3600, function () {
            $url = "{$this->source}/{$this->base}.json";

            $resp = Http::timeout(10)->get($url);

            // fallback if cdn fails
            if ($resp->failed()) {
                $fallback = "https://latest.currency-api.pages.dev/v1/currencies/{$this->base}.json";
                $resp = Http::timeout(10)->get($fallback);
            }

            if ($resp->failed()) {
                throw new \Exception('Currency API failed: ' . $resp->body());
            }

            $data = $resp->json();

            $date = $data['date'] ?? now()->toDateString();
            $rates = $data[$this->base] ?? [];

            if (!is_array($rates) || empty($rates)) {
                throw new \Exception('Unexpected currency API response');
            }

            return [
                'date'  => $date,
                'rates' => $rates
            ];
        });
    }

    /**
     * Convert amount (base PKR) to $toCurrency (like 'usd', 'EUR', etc.)
     * Returns ['rate' => float, 'converted' => float, 'date' => 'YYYY-MM-DD']
     */
    public function convert(float $amount, string $toCurrency): array
    {
        $to = strtolower($toCurrency);

        $data = $this->getRates();
        $rates = $data['rates'];
        $date = $data['date'];

        if ($to === $this->base) {
            return [
                'rate'      => 1.0,
                'converted' => round($amount, 2),
                'date'      => $date
            ];
        }

        if (!isset($rates[$to])) {
            throw new \Exception("Conversion rate not available for {$toCurrency}");
        }

        $rate = $rates[$to];
        $converted = round($amount * $rate, 2);

        return [
            'rate'      => $rate,
            'converted' => $converted,
            'date'      => $date
        ];
    }
}


