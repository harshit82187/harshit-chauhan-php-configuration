use App\Traits\User\NotificationTrait;

class UserController extends Controller
{

        use NotificationTrait;

    public function store(Request $request)
    {
        // dd($request->all());
        $log = Log::channel('staff_user');
        $request->validate([
            'email'  => 'required|email|unique:users,email',
            'mobile' => 'required|unique:users,phone',
        ]);
        try {
            $log->info('User store request received', ['email' => $request->email]);
            if (User::where('email', $request->email)->exists()) {
                $log->warning('Email already used', ['email' => $request->email]);
                flash(translate('Email already used'))->error();
                return back();
            }

            $user = new User;
            $user->first_name = $request->first_name;
            $user->last_name  = $request->last_name;
            $user->email      = $request->email;
            $user->phone      = $request->mobile;
            $user->user_type  = "staff";
            $user->password   = Hash::make($request->password);
            $user->email_verified_at = now();
            $user->address = $request->address;
            $user->department_id = $request->department_id;
            $user->role_id = $request->role_id;
            $user->hourly_rate = $request->hourly_rate;

            if (!$user->save()) {
                $log->error('Failed to save user', ['email' => $request->email]);
                flash(translate('Failed to save user'))->error();
                return back();
            }

            $log->info('User saved successfully', ['user_id' => $user->id]);

            // Aurora API call
            try {
                $tenantId = getenv('SOLAR_TENANT_ID');
                $data = [
                    'user' => [
                        'first_name' => $request->first_name,
                        'last_name'  => $request->last_name,
                        'email'      => $request->email,
                        'phone'      => $request->mobile,
                        'external_provider_id' => 'https://www.pearlorganisation.com?p=' . time()
                    ]
                ];

                $response = store_user_curl('https://api.aurorasolar.com/tenants/' . $tenantId . '/users', $data);
                $log->info('Aurora API response', ['response' => $response]);

                $userId = $response['user']['id'] ?? null;
            } catch (Exception $apiEx) {
                $log->error('Aurora API Error', ['message' => $apiEx->getMessage(), 'email' => $request->email]);
                $userId = null;
            }

            $staff = new Staff;
            $staff->user_id = $user->id;
            $staff->role_id = $request->role_id;
            $staff->is_api = 1;
            $staff->is_api_id = $userId;

            $user->assignRole(Role::findOrFail($request->role_id)->name);

            if (!$staff->save()) {
                $log->error('Failed to save staff record', ['user_id' => $user->id]);
                flash(translate('Failed to save staff record'))->error();
                return back();
            }

            $role_name = Role::where('id', $staff->role_id)->value('name');

            if ($user->email && get_email_template('staff_account_opening_email', 'status')) {
                EmailUtility::staff_account_opening_email($user, $request->password, $role_name);
                $log->info('Staff account opening email sent', ['email' => $user->email]);
            }

            if ($user->phone && addon_activation('otp_system') && (get_sms_template('staff_account_opening', 'status') == 1)) {
                SmsUtility::staff_account_opening($user, $request->password, $role_name);
                $log->info('Staff account opening SMS sent', ['phone' => $user->phone]);
            }

            $log->info('User inserted successfully', ['user_id' => $user->id]);

            $this->createCRMNotification(
                type: 'user_created',
                title: 'New Staff User Created',
                message: $user->first_name . ' ' . $user->last_name . ' has been created.',
                related_id: $user->id,
                related_module: 'users',
                notifyUsers: [
                    Auth::id(),     // jisne create kiya
                    $user->id       // jo create hua
                ]
            );

            $log->info('User Create Successfylly!');
            flash(translate('User inserted successfully'))->success();
            return redirect()->route('users.index');

        } catch (Exception $e) {
            $log->error('Error in store() method', [
                'message' => $e->getMessage(),
                'line' => $e->getLine(),
                'file' => $e->getFile(),
                'trace' => $e->getTraceAsString(),
            ]);

            flash(translate('Something went wrong. Please check logs.'))->error();
            return back();
        }
    }
}




