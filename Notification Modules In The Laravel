<?php
namespace App\Http\Controllers\Member;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;

use App\Models\CRMNotificationUser;
use App\Models\CRMNotificationReadLog;

use Mpdf\Mpdf;
use Mail;
use Log;
use auth;



class NotificationsController extends Controller
{

    public function markAsRead(){
        try{
            $user = auth()->user();
            $unread =  CRMNotificationUser::where('user_id', $user->id)->where('is_read', 0)->get();
            CRMNotificationUser::where('user_id', $user->id)->where('is_read', 0)->update(['is_read' => 1,'read_at' => now()]);
            if(count($unread) == 0){
                return response()->json([
                    'status' => 'info',
                    'message' => 'No unread notifications found.',
                ], 200);
            }
            foreach($unread as $notification){
                CRMNotificationReadLog::create([
                    'notification_id' => $notification->notification_id,
                    'user_id'         => $user->id,
                    'read_at'         => now(),
                ]);
            }
            return response()->json([
                'status' => 'success',
                'message' => 'All notifications marked as read.',
                'unread'   => count($unread),
            ], 200);

        }catch (\Throwable  $e) {
                return response()->json([
                'status' => 'error',
                'message' => $e->getMessage()
            ], 500);
        }
    }
    
   
}





