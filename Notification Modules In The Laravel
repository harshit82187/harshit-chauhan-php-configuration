                },
                error: function (xhr, status, error) {
                    AIZ.plugins.notify('danger', error);
                }
            });
        });


        function fetchNotification() {
            $.ajax({
                url: fetchNotificationRoute,
                type: 'GET',
                dataType: "JSON",
