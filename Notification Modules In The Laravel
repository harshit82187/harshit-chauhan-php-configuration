<?php

namespace App\Traits\Department;

use App\Models\CRMNotification;
use App\Models\CRMNotificationUser;
use Illuminate\Support\Facades\Auth;

trait DepartmentNotificationTrait
{
    public function createDepartmentNotification(
        string $type,
        string $title,
        string $message,
        int $departmentId
    ) {
        $notification = CRMNotification::create([
            'type'           => $type,
            'title'          => $title,
            'message'        => $message,
            'created_by'     => Auth::id(),
            'related_id'     => $departmentId,
            'related_module' => 'departments',
        ]);

        // 👉 Sirf current user ko notification
        CRMNotificationUser::create([
            'notification_id' => $notification->id,
            'user_id'         => Auth::id(),
            'message'         => $message,
            'is_read'         => 0,
        ]);

        return $notification;
    }
}









