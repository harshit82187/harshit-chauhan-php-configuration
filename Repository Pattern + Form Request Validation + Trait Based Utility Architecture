Step :- 1) app/Traits/ImageUploadTrait.php

<?php

namespace App\Traits;

use Illuminate\Http\UploadedFile;

trait ImageUploadTrait
{
    /**
     * Upload Image & return file path
     */
    public function uploadImage(?UploadedFile $image, $path)
    {
        if (!$image) return null;
        $year = now()->year;
        $month = now()->format('M');
        $fullPath = $path . "/{$year}/{$month}";
        if (!is_dir(public_path($fullPath))) {
            mkdir(public_path($fullPath), 0777, true);
        }
        $fileName = time() . '_' . uniqid() . '.' . $image->getClientOriginalExtension();
        $image->move(public_path($fullPath), $fileName);
        return $fullPath . '/' . $fileName;
    }
}




Step :- 2) UserRequest (Form Validation)

app/Http/Requests/UserRequest.php

<?php

namespace App\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;

class UserRequest extends FormRequest
{
    public function authorize()
    {
        return true;
    }

    public function rules()
    {
        return [
            "name"          => "required|string|max:255",
            "email"         => "required|email|unique:users,email",
            "mobile_no"     => "required|digits:10",
            "address"       => "required|string",
            "gender"        => "required|in:male,female,other",
            "profile_photo" => "nullable|image|mimes:jpg,jpeg,png,webp|max:2048",
        ];
    }
}


