razorpay.js file code



$(document).ready(function(){
    if (typeof check_in === 'undefined' || typeof check_out === 'undefined' || typeof price === 'undefined') {
        console.error("Error: Required variables are undefined.");
        return;
    }
    var propertyPrice = parseFloat(price);
    var checkInDate = new Date(check_in);
    var checkOutDate = new Date(check_out);
    var gst = 0;

    if (isNaN(checkInDate.getTime()) || isNaN(checkOutDate.getTime())) {
        console.error("Error: Invalid date format");
        return;
    }

    var timeDiff = checkOutDate - checkInDate;
    var days = Math.ceil(timeDiff / (1000 * 60 * 60 * 24)); 

    if (days <= 0) {
        days = 1;
    }

    var baseRate = propertyPrice * days;
    if(baseRate <= 7500){
        gst = 12;
    }else{
        gst = 18;
    }
    var totalTax = (baseRate * gst) / 100;  
    var totalAmount = baseRate + totalTax; 
    console.log("Base Rate:", baseRate);
    console.log("Total Tax", totalTax);
    console.log("Total Amount:", totalAmount);
    console.log("Price per night:", propertyPrice);
    console.log("Days stayed:", days);
    console.log("Gst Charges:", gst);

    $("#total_amount").html("₹ " + totalAmount.toFixed(2));
    $("#base_rate").html("₹ " + baseRate.toFixed(2));
    $('#day-spend').html(days);
    $('#amount').val(totalAmount);
    $('#total-tax').html("₹ " + totalTax.toFixed(2));
    $('#gst_value').html(gst + "%");

    $("#pay_now").submit(function(e){
        e.preventDefault();
        console.log("Amount is valid, proceeding with Razorpay");
        razorpaySubmit();
    });

    var razorpayPaymentId = "";
    let RtotalAmount = 0; // Initialize amount
    function updateRazorpayOptions(newAmount = null) {
        let RtotalAmount = newAmount ? newAmount : parseFloat($("#amount").val());
        let totalAmountInPaise = RtotalAmount * 100;
    
        console.log("Updated Amount on Razorpay: " + totalAmountInPaise);
        razorpay_options.amount = totalAmountInPaise.toString();
    }

    // Razorpay options
    var razorpay_options = {
        key: RAZORPAY_KEY,
        amount: RtotalAmount * 100,
        name: "Tensor",
        description: "Property Booking",
        image:razorpay_logo,
        netbanking: true,
        currency: "INR",
        prefill: {
            name: "{{ Auth::User()->name }}",
            email: "{{ Auth::User()->email }}",
            contact: "{{ Auth::User()->mobile }}"
        },
        "theme": { "color": "#012549" },
        handler: function (transaction) {
            razorpayPaymentId = transaction.razorpay_payment_id;
            console.log("Payment ID: " + razorpayPaymentId);
            document.getElementById('razorpay_payment_id').value = razorpayPaymentId;
            $('#gst_amount').val(totalTax); 
            console.log("Base Rate before setting:", baseRate);
            $('#base_amount').val(baseRate);
            console.log("Base Amount field value:", $('#base_amount').val());            
            document.getElementById('pay_now').submit();

        },
        modal: {
            ondismiss: function () {
                location.reload();
            }
        }
    };

    // Open Razorpay Checkout
    var razorpay_instance;
    function razorpaySubmit(el) {
        console.log("Opening Razorpay Checkout");
        $('#pay-online').val('Please Wait...').prop('disabled', true).css('cursor', 'no-drop');
        $('#paymentLoader').removeClass('d-none');
        updateRazorpayOptions(); 

        if (!razorpay_instance) {
            console.log("Creating new Razorpay instance");
            razorpay_instance = new Razorpay(razorpay_options);
        }
        razorpay_instance.open(); 
    }


    
});

