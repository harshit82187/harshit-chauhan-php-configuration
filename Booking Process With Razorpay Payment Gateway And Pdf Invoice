CREATE TABLE `payments` (
  `id` bigint(20) NOT NULL,
  `r_payment_id` varchar(250) DEFAULT NULL,
  `merchant_order_id` varchar(250) DEFAULT NULL,
  `method` varchar(250) DEFAULT NULL,
  `currency` varchar(250) DEFAULT NULL,
  `user_email` varchar(250) DEFAULT NULL,
  `amount` varchar(250) DEFAULT NULL,
  `json_response` longtext DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp()
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;





CREATE TABLE `bookings` (
  `id` int(11) NOT NULL,
  `user_id` int(11) NOT NULL,
  `booking_type` enum('1','2','3','') DEFAULT NULL COMMENT '1 => Ferry-Booking\r\n2 => Hotel-Booking\r\n3 => Tour-Package-Booking',
  `relative_table_id` int(11) DEFAULT NULL,
  `invoice` longtext DEFAULT NULL,
  `r_payment_id` varchar(250) DEFAULT NULL,
  `invoice_pdf` longtext DEFAULT NULL,
  `adult` varchar(250) DEFAULT NULL,
  `children` varchar(250) DEFAULT NULL,
  `booking_date` varchar(250) DEFAULT NULL,
  `amount` varchar(250) DEFAULT NULL,
  `passenger_name` longtext DEFAULT NULL,
  `phone` longtext DEFAULT NULL,
  `age` longtext DEFAULT NULL,
  `gender` longtext DEFAULT NULL,
  `class_type` varchar(250) DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NULL DEFAULT current_timestamp() ON UPDATE current_timestamp()
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;





