   public function ferryBookingStore(Request $request)
    {
        $request->validate([
            'ferry_table_id' => 'required|numeric',
            'razorpay_payment_id' => 'required|string',
            'transaction_via' => 'required|string',
            'amount' => 'required|numeric',
            'adult' => 'required|numeric',
            'children' => 'required|numeric',
            'class_type' => 'required',
            'booking_date' => 'required|date',
            'merchant_order_id' => 'required|string',
            'passenger_name' => 'required|array',
            'phone' => 'required|array',
            'age' => 'required|array',
            'gender' => 'required|array',
        ]);

        if (Auth::check()) {
            $paymentData = [
                'razorpay_payment_id' => $request->razorpay_payment_id,
                'merchant_order_id' => $request->merchant_order_id,
                'amount' => $request->amount,
            ];

            $payment = $this->proceedPayment($paymentData);

            if ($payment === 'captured') {
                $ferry = FerryBooking::find($request->ferry_table_id);

                if (!$ferry) {
                    return back()->with('error', 'Booking details not found!');
                }

                $user = Auth::user();
                $invoiceNumber = now()->format('Ym') . rand(100000, 999999);

                // Create booking
                $booking = Booking::create([
                    'user_id' => $user->id,
                    'booking_type' => '1',
                    'relative_table_id' => $request->ferry_table_id,
                    'invoice' => $invoiceNumber,
                    'r_payment_id' => $request->razorpay_payment_id,
                    'adult' => $request->adult,
                    'children' => $request->children,
                    'booking_date' => $request->booking_date,
                    'amount' => $request->amount,
                    'passenger_name' => json_encode($request->passenger_name),
                    'phone' => json_encode($request->phone),
                    'age' => json_encode($request->age),
                    'gender' => json_encode($request->gender),
                    'class_type' => $request->class_type,
                ]);

                // Generate invoice and save PDF
                $year = now()->year;
                $month = now()->format('M');
                $today = Carbon::now()->format('d-M-Y');
                $fileName = "invoice_{$invoiceNumber}.pdf";
                $directoryPath = public_path("ferry-booking/{$year}/{$month}");
                $adminEmail = View::shared('adminEmail');

                if (!File::exists($directoryPath)) {
                    File::makeDirectory($directoryPath, 0777, true);
                }


                    // Generate the QR code with the route
                    $qrCode = new QrCode(route('invoice.show', ['invoiceNumber' => $invoiceNumber]));
                    $writer = new PngWriter();
                    $qrCodeContent = $writer->write($qrCode)->getString();

                     // Save QR code to the local path
                    $qrCodeDirectory = public_path("qr-codes/{$year}/{$month}");
                    if (!File::exists($qrCodeDirectory)) {
                        File::makeDirectory($qrCodeDirectory, 0777, true);
                    }

                     // Define the file path for the QR code
                    $qrCodeFilePath = "{$qrCodeDirectory}/{$invoiceNumber}-qr.jpg"; // Local file path for QR code
                    file_put_contents($qrCodeFilePath, $qrCodeContent);

                    $booking->update([
                        'qr_image' => "qr-codes/{$year}/{$month}/{$invoiceNumber}-qr.jpg",
                    ]);

                   // Generate the PDF
                    $filePath = "{$directoryPath}/{$fileName}";
                    $pdf = Pdf::loadView('pdf.ferry-booking-invoice', compact('ferry', 'user', 'request', 'booking', 'adminEmail', 'today', 'qrCodeFilePath'));
                    $pdf->save($filePath);

                        // Update booking with generated PDF file path
                        $booking->update([
                            'invoice_pdf' => "ferry-booking/{$year}/{$month}/{$fileName}",
                        ]);

                // Send emails

                $this->sendEmail($user->email, $user, $ferry, $booking, 'user');
                $this->sendEmail($adminEmail, $user, $ferry, $booking, 'admin');

                return redirect()->route('thank.you', [
                    'string' => Str::random(500),
                    'ferry' => $ferry,
                    'user' => $user,
                    'booking' => $booking,
                    'type' => 1,
                ])->with('success', 'Payment successful and booking completed');
            }

            return back()->with('error', 'Payment failed!');
        }
    }

    private function sendEmail($email, $user, $ferry, $booking, $role)
    {
        $subject = 'Ferry Booking Invoice';
        $isAdmin = ($role === 'admin');

        Mail::send('email.email-booking', compact('user', 'ferry', 'booking', 'role', 'isAdmin'), function ($message) use ($email, $subject, $booking) {
            $message->to($email);
            $message->subject($subject);
            $message->attach(public_path($booking->invoice_pdf));
        });
    }

