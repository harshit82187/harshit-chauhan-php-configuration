<script>
    $(document).ready(function() {
        $('.upload-bar').addClass('d-none');
	    $('#video-add').on('submit', async function(e) {
	        e.preventDefault(); // prevent default form submit
	        let files = $('input[name="content[]"]')[0].files;
	        let maxSize = 250 * 1024 * 1024; // 250 MB
	        let errorFiles = [];
	
	        // Check file sizes
	        for (let i = 0; i < files.length; i++) {
	            if (files[i].size > maxSize) {
	                errorFiles.push(files[i].name);
	            }
	        }
	
	        if (errorFiles.length > 0) {
	            iziToast.error({
	                title: 'Error!',
	                message: `File(s) exceed 250 MB: ${errorFiles.join(', ')}`,
	                position: 'topRight'
	            });
	            return false;
	        } 
	
	        $('#loader').removeClass('d-none');   
	        let formData = new FormData(this);
	        let btn = $(this).find('#submit');
	        btn.html('⏳ Uploading...').prop('disabled', true).css('cursor', 'no-drop');
            $('.upload-bar').removeClass('d-none');
	
	        // AJAX upload with progress
	        $.ajax({
	            url: $(this).attr('action'),
	            type: 'POST',
	            data: formData,
	            contentType: false,
	            processData: false,
	            xhr: function() {
	                let xhr = new window.XMLHttpRequest();
	                xhr.upload.addEventListener("progress", function(evt) {
	                    if (evt.lengthComputable) {
	                        let percentComplete = Math.round((evt.loaded / evt.total) * 100);
	                        $('#uploadProgress').css('width', percentComplete + '%').text(percentComplete + '%');
	                    }
	                }, false);
	                return xhr;
	            },
	            success: function(res) {
	                $('#uploadProgress').css('width','100%').text('100%');
                    $('.upload-bar').addClass('d-none');
	                iziToast.destroy();
	                iziToast.info({
	                    title: 'Success',
	                    message: 'Videos uploaded successfully!',
	                    position: 'topRight'
	                });
	
	                // Close modal + refresh page after short delay
	                setTimeout(function() {
	                    $('#addVideo').modal('hide');
	                    location.reload();
	                }, 1000);
	            },
	            error: function(xhr) {
                    $('.upload-bar').addClass('d-none');
	                iziToast.destroy();
	                iziToast.error({
	                    title: 'Error!',
	                    message: xhr.responseText || 'Something went wrong',
	                    position: 'topRight'
	                });
	                btn.html('Upload').prop('disabled', false).css('cursor', 'pointer');
	                $('#uploadProgress').css('width','0%').text('0%');
	            }
	        });
	    });
	});
</script>




