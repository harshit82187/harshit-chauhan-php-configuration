public function toggleMaintenance(Request $request)
  {
      // dd($request->all());
      $status = $request->input('status') === 'on' ? 'on' : 'off';
      Setting::set('maintenance_mode', $status);

      return response()->json(['message' => 'Maintenance mode updated successfully!']);
  }

