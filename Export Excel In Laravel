<?php

namespace App\Exports;

use App\Enquiry;
use Maatwebsite\Excel\Concerns\FromCollection;
use Maatwebsite\Excel\Concerns\WithHeadings;

class LeadExport implements FromCollection, WithHeadings
{
    protected $startDate;
    protected $endDate;

    // Constructor to accept date range
    public function __construct($startDate, $endDate)
    {
        $this->startDate = $startDate;
        $this->endDate = $endDate;
    }

    // Fetch the data for export
    public function collection()
    {
        $enquiry = Enquiry::whereBetween('created_at', [$this->startDate, $this->endDate])
                         ->get(['id', 'name', 'email', 'phone', 'created_at']);
        
        return $enquiry;
    }

    // Specify the column headings
    public function headings(): array
    {
        return [
            'ID',
            'Name',
            'Email',
            'Phone',
            'Created At',
        ];
    }
}
