use App\Exports\LeadExport;
use Maatwebsite\Excel\Facades\Excel;

   public function manageExportLeadData(Request $req)
    {
        try {
            $req->validate([
                'exportStatus' => 'required|string',
            ]);
    
            $startDate = null;
            $endDate = null;
    
            // Handle different export status cases
            switch ($req->input('exportStatus')) {
                case 'Today':
                    $startDate = Carbon::today()->startOfDay()->toDateTimeString();
                    $endDate = Carbon::today()->endOfDay()->toDateTimeString();
                    break;
                case 'Yesterday':
                    $startDate = Carbon::yesterday()->startOfDay()->toDateTimeString();
                    $endDate = Carbon::yesterday()->endOfDay()->toDateTimeString();
                    break;
                case 'Last 7 Day':
                    $startDate = Carbon::now()->subDays(7)->startOfDay()->toDateTimeString();
                    $endDate = Carbon::today()->endOfDay()->toDateTimeString();
                    break;
                case 'This Month':
                    $startDate = Carbon::now()->startOfMonth()->toDateTimeString();
                    $endDate = Carbon::now()->endOfMonth()->toDateTimeString();
                    break;
                case 'Last Month':
                    $startDate = Carbon::now()->subMonth()->startOfMonth()->toDateTimeString();
                    $endDate = Carbon::now()->subMonth()->endOfMonth()->toDateTimeString();
                    break;
                case 'Custom Date':
                    // Validate custom date range
                    $req->validate([
                        'export_start_date' => 'required|date',
                        'export_end_date' => 'required|date|after_or_equal:export_start_date',
                    ]);
    
                    $startDate = Carbon::parse($req->input('export_start_date'))->startOfDay()->toDateTimeString();
                    $endDate = Carbon::parse($req->input('export_end_date'))->endOfDay()->toDateTimeString();
                    break;
                default:
                    return back()->with('error', 'Warning: Invalid Export');
            }
    
            \Log::info("Start Date: $startDate, End Date: $endDate");
            return Excel::download(new LeadExport($startDate, $endDate), 'leads_export.xlsx');
    
        } catch (\Exception $e) {
            return back()->with('error', 'Warning: ' . $e->getMessage());
        }
    }





