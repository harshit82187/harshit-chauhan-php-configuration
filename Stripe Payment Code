private function createStripeCustomer(Request $request, $user)
{
    // agar pehle se customer exist karta hai
    if ($user->stripe_customer_id) {

        return \Stripe\Customer::retrieve($user->stripe_customer_id);

    }

    // warna new customer create karo
    $customer = \Stripe\Customer::create([
        "address" => [
            "line1" => $request->address ?? 'N/A',
            "country" => $request->country,
        ],
        "email" => $user->email,
        "name" => $user->name,
        "phone" => $user->mobile,
        "source" => $request->stripeToken,
    ]);

    // database me save karo
    $user->stripe_customer_id = $customer->id;
    $user->save();

    return $customer;
}






