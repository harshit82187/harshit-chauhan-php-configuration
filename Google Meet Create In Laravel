<?php

namespace App\Mail\GoogleMeet;

use Illuminate\Bus\Queueable;
use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Mail\Mailable;
use Illuminate\Queue\SerializesModels;
use Carbon\Carbon;

class MeetingScheduleNotification extends Mailable implements ShouldQueue
{
    use Queueable, SerializesModels;

    public $meeting, $attendees, $passcode;

    public function __construct($meeting, $attendees, $passcode)
    {
        $this->meeting   = $meeting;
        $this->attendees = $attendees;
        $this->passcode  = $passcode;
    }

    public function build()
    {
        $start = Carbon::parse(
            $this->meeting->date . ' ' . $this->meeting->time
        );

        $end = (clone $start)->addMinutes(40);

        return $this->subject(
                'Ⓜ️ Invitation: ' . $this->meeting->meeting_name .
                ' @ ' . $start->format('D M d, Y h:i A') .
                ' - ' . $end->format('h:i A') .
                ' (IST) | Harshit Chauhan Laravel Project'
            )
            ->view('mail-template.google-meet.meeting-schedule');
    }
}


