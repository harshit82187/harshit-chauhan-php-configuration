<?php

namespace App\Http\Controllers\Auth;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Google\Client;
use Google\Service\Calendar;
use Carbon\Carbon;
use Illuminate\Support\Facades\Log;

use App\Models\User;
use App\Models\GoogleMeeting;
use App\Models\GoogleToken;
use Illuminate\Support\Facades\Mail;
use App\Mail\GoogleMeet\MeetingScheduleNotification;

class GoogleMeetController extends Controller
{
    /**
     * Step 1: Redirect user to Google OAuth
     */
    public function redirectToGoogle()
    {
        Log::info('Redirecting to Google OAuth', config('services.google'));
        $client = new Client();
        $client->setClientId(config('services.google.client_id'));
        $client->setClientSecret(config('services.google.client_secret'));
        $client->setRedirectUri(config('services.google.redirect'));

        $client->addScope(Calendar::CALENDAR);
        $client->setAccessType('offline');
        $client->setPrompt('consent select_account');

        return redirect($client->createAuthUrl());
    }

    /**
     * Step 2: Google OAuth Callback
     * Token DB me save hoga (NO SESSION)
     */
    public function handleGoogleCallback(Request $request)
    {
        Log::info('Google Callback Hit', $request->all());
        if (!$request->has('code')) {
            Log::error('Google callback without auth code');
            return redirect('/google-auth');
        }

        $client = new Client();
        $client->setClientId(config('services.google.client_id'));
        $client->setClientSecret(config('services.google.client_secret'));
        $client->setRedirectUri(config('services.google.redirect'));

        $token = $client->fetchAccessTokenWithAuthCode($request->code);
        Log::info('Google Token Response', $token);

        if (isset($token['error'])) {
            Log::error('Google Token Error', $token);
            return redirect('/google-auth');
        }

        GoogleToken::updateOrCreate(
            ['user_id' => auth()->id()],
            [
                'access_token'  => $token['access_token'],
                'refresh_token' => $token['refresh_token'] ?? null,
                'expires_in'    => $token['expires_in'] ?? null,
                'scope'         => $token['scope'] ?? null,
                'token_type'    => $token['token_type'] ?? null,
            ]
        );
        Log::info('Google Token Saved In DB', [
            'user_id' => auth()->id()
        ]);

        return redirect('/meeting-form');
    }

    /**
     * Step 3: Meeting Form
     */
    public function meetingForm()
    {
        Log::info('Meeting Form Loaded');
        $users = User::select('id', 'name', 'email')->get();
        return view('auth.google-meet.index', compact('users'));
    }

    /**
     * Step 4: Create Google Meet + Save DB
     */
    public function createMeeting(Request $request)
    {
        Log::info('Create Meeting Request', $request->all());
        $request->validate([
            'meeting_name' => 'required|string',
            'attendees'    => 'required|array',
            'date'         => 'required|date',
            'time'         => 'required',
        ]);

        $tokenData = GoogleToken::where('user_id', auth()->id())->first();
        Log::info('Fetched Token From DB', $tokenData ? $tokenData->toArray() : []);
        if (!$tokenData) {
            Log::error('Google token missing in DB');
            return redirect('/google-auth');
        }

        // Google Client
        $client = new Client();
        $client->setClientId(config('services.google.client_id'));
        $client->setClientSecret(config('services.google.client_secret'));

        $client->setAccessToken([
            'access_token'  => $tokenData->access_token,
            'refresh_token' => $tokenData->refresh_token,
            'expires_in'    => $tokenData->expires_in,
            'token_type'    => $tokenData->token_type,
        ]);

        // 🔁 Auto refresh token
        if ($client->isAccessTokenExpired()) {
            Log::warning('Access token expired, refreshing...');
            if (!$tokenData->refresh_token) {
                Log::error('Refresh token missing');
                return redirect('/google-auth');
            }

            $newToken = $client->fetchAccessTokenWithRefreshToken(
                $tokenData->refresh_token
            );
            Log::info('New Token Generated', $newToken);

            $tokenData->update([
                'access_token' => $newToken['access_token'],
                'expires_in'   => $newToken['expires_in'] ?? null,
            ]);

            $client->setAccessToken([
                'access_token'  => $newToken['access_token'],
                'refresh_token' => $tokenData->refresh_token,
            ]);
        }

        $service = new Calendar($client);

        // Attendees (Google)
        $googleAttendees = [];
        $users = User::whereIn('id', $request->attendees)->get();

        foreach ($users as $user) {
            if ($user->email) {
                $googleAttendees[] = ['email' => $user->email];
            }
        }
        Log::info('Google Attendees', $googleAttendees);

        $start = Carbon::parse($request->date . ' ' . $request->time);
        $end   = (clone $start)->addMinutes(30);

        $event = new \Google\Service\Calendar\Event([
            'summary'   => $request->meeting_name,
            'attendees' => $googleAttendees,
            'start' => [
                'dateTime' => $start->toIso8601String(),
                'timeZone' => 'Asia/Kolkata',
            ],
            'end' => [
                'dateTime' => $end->toIso8601String(),
                'timeZone' => 'Asia/Kolkata',
            ],
            'conferenceData' => [
                'createRequest' => [
                    'requestId' => uniqid(),
                    'conferenceSolutionKey' => [
                        'type' => 'hangoutsMeet',
                    ],
                ],
            ],
        ]);

        $event = $service->events->insert(
            'primary',
            $event,
            ['conferenceDataVersion' => 1]
        );
        Log::info('Google Meet Created', [
            'event_id' => $event->id,
            'meet_link' => $event->hangoutLink
        ]);

        // Save in DB
        $meeting =  GoogleMeeting::create([
            'meeting_name' => $request->meeting_name,
            'attendees'    => $request->attendees,
            'date'         => $request->date,
            'time'         => $request->time,
            'meet_link'    => $event->hangoutLink,
        ]);
        Log::info('Meeting Saved In DB');

        $attendeeUsers = User::whereIn('id', $request->attendees)->get();
        $passcode = 123456;
        $attendeeNames = $attendeeUsers->pluck('name')->filter()->implode(', ');

        foreach ($attendeeUsers as $user) {
            if (!$user->email) {
                Log::warning('User email missing', ['user_id' => $user->id]);
                continue;
            }
            Mail::to($user->email)->queue(new MeetingScheduleNotification($meeting, $attendeeNames, $passcode));
            Log::info('Meeting email queued', [
                'email' => $user->email
            ]);
        }

        return view('auth.google-meet.result', [
            'meet_link' => $event->hangoutLink
        ]);
    }
}


