<script>
$(document).ready(function () {

    /* ---------- DATE ---------- */
    let today = new Date();
    let yyyy = today.getFullYear();
    let mm = String(today.getMonth() + 1).padStart(2, '0');
    let dd = String(today.getDate()).padStart(2, '0');

    let todayDate = yyyy + '-' + mm + '-' + dd;

    // set current date
    $('#meeting_date').val(todayDate);

    // disable past dates
    $('#meeting_date').attr('min', todayDate);


    /* ---------- TIME (Current + 1 Hour) ---------- */
    let now = new Date();
    now.setHours(now.getHours() + 1);

    let hh = String(now.getHours()).padStart(2, '0');
    let min = String(now.getMinutes()).padStart(2, '0');

    let timePlusOneHour = hh + ':' + min;

    $('#meeting_time').val(timePlusOneHour);


    /* ---------- Prevent past time if today selected ---------- */
    $('#meeting_date').on('change', function () {

        let selectedDate = $(this).val();

        if (selectedDate === todayDate) {
            let currentTime = new Date();
            currentTime.setHours(currentTime.getHours() + 1);

            let h = String(currentTime.getHours()).padStart(2, '0');
            let m = String(currentTime.getMinutes()).padStart(2, '0');

            $('#meeting_time').attr('min', h + ':' + m);
        } else {
            $('#meeting_time').removeAttr('min');
        }
    });

});
</script>

