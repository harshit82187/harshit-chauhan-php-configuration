<?php

namespace App\Http\Controllers\Auth;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;

use Google\Client;
use Google\Service\Calendar;
use Carbon\Carbon;
use Session;
use Illuminate\Support\Facades\Log;
use App\Models\GoogleMeeting;


class GoogleMeetController extends Controller
{

    public function redirectToGoogle()
    {
        Log::info('Google Config', config('services.google'));

        $client = new Client();
        $client->setClientId(config('services.google.client_id'));
        $client->setClientSecret(config('services.google.client_secret'));
        $client->setRedirectUri(config('services.google.redirect'));

        $client->addScope(Calendar::CALENDAR);
        $client->setAccessType('offline');
        $client->setPrompt('consent select_account');

        return redirect($client->createAuthUrl());
    }



    public function handleGoogleCallback(Request $request)
    {
        Log::info('Callback Hit', $request->all());

        if (!$request->has('code')) {
            Log::error('No auth code received');
            return redirect('/google-auth');
        }

        // ✅ USE CONFIG — NOT ENV
        $client = new Client();
        $client->setClientId(config('services.google.client_id'));
        $client->setClientSecret(config('services.google.client_secret'));
        $client->setRedirectUri(config('services.google.redirect'));

        Log::info('Using Redirect URI:', [
            'uri' => config('services.google.redirect')
        ]);

        $token = $client->fetchAccessTokenWithAuthCode($request->code);

        Log::info('Token Response:', $token);

        if (isset($token['error'])) {
            Log::error('Token Error', $token);
            return response()->json($token);
        }

        Session::put('google_access_token', $token);

        return redirect('/meeting-form');
    }




    public function meetingForm(){
        return view('auth.google-meet.index');
    }

    public function createMeeting(Request $request)
    {
        Log::info('Create Meeting Request', $request->all());

        $token = Session::get('google_access_token');
        Log::info('Stored Token:', $token ?? []);

        if (!$token || !isset($token['access_token'])) {
            Log::error('Token missing, redirecting to auth');
            return redirect('/google-auth');
        }

        $client = new Client();

        // 🔥 THIS WAS MISSING (MAIN FIX)
        $client->setClientId(config('services.google.client_id'));
        $client->setClientSecret(config('services.google.client_secret'));

        $client->setAccessToken($token);

        // OPTIONAL: token expire ho jaye to auto refresh
        if ($client->isAccessTokenExpired() && isset($token['refresh_token'])) {
            $newToken = $client->fetchAccessTokenWithRefreshToken($token['refresh_token']);
            Session::put('google_access_token', array_merge($token, $newToken));
            $client->setAccessToken(Session::get('google_access_token'));
        }

        $service = new Calendar($client);

        $start = Carbon::parse($request->date.' '.$request->time);
        $end   = (clone $start)->addMinutes(30);

        $event = new \Google\Service\Calendar\Event([
            'summary' => $request->meeting_name,
            'start' => [
                'dateTime' => $start->toIso8601String(),
                'timeZone' => 'Asia/Kolkata',
            ],
            'end' => [
                'dateTime' => $end->toIso8601String(),
                'timeZone' => 'Asia/Kolkata',
            ],
            'conferenceData' => [
                'createRequest' => [
                    'requestId' => uniqid(),
                    'conferenceSolutionKey' => [
                        'type' => 'hangoutsMeet',
                    ],
                ],
            ],
        ]);

        $event = $service->events->insert(
            'primary',
            $event,
            ['conferenceDataVersion' => 1]
        );

        // ✅ SAVE IN DB
        GoogleMeeting::create([
            'meeting_name' => $request->meeting_name,
            'date' => $request->date,
            'time' => $request->time,
            'meet_link' => $event->hangoutLink,
        ]);

        return view('auth.google-meet.result', [
            'meet_link' => $event->hangoutLink
        ]);
    }







}


