******************************************************************************* Database Seeder *********************************************************************************************
Database Seeder Laravel ka ek feature hota hai jo dummy / sample data database me automatically insert karta hai.

Step : 1 php artisan make:seeder UserSeeder

Step : 2 database/seeders/UserSeeder.php

<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Faker\Factory as Faker;

class UserSeeder extends Seeder
{
    public function run()
    {
        $faker = Faker::create();

        for ($i = 1; $i <= 10; $i++) {
            DB::table('users')->insert([
                'name' => $faker->name,
                'email' => $faker->unique()->safeEmail,
                'email_verified_at' => now(),
                'password' => Hash::make('password'), // default password
                'remember_token' => \Str::random(10),
                'created_at' => now(),
                'updated_at' => now(),
            ]);
        }
    }
}


Step :3 Seeder run karo 
php artisan db:seed --class=UserSeeder
