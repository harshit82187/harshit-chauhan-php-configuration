<?php

namespace App\Http\Controllers\auth;

use Illuminate\Http\Request;
use App\Http\Controllers\Controller;


use App\Models\User;
use App\Models\ForgetPassword;
use Mail; 
use Hash;
use Auth;

use Illuminate\Support\Str;
use Illuminate\Support\Facades\Log;


class ForgetPasswordController extends Controller
{

    public function showForgotPasswordForm(){
        return view('admin.auth.password-forgot.view');
    }

     public function handleForgotPasswordRequest(Request $req){
        // dd($req->all());
        $req->validate([
         'email' => 'required|email',
        ]);
        $admin = Admin::where('email',$req->email)->first();
        if(!$admin){
            return back()->with('error','This email address does not exist In the databse!');
        }
        $token = Str::random(64);
        $subject = "🔔 Admin Password Reset Email Notification | 🗓️ " . \Carbon\Carbon::today()->format('d-M-Y') . " | 🕒 " . \Carbon\Carbon::now()->format('h:i A');
        $email = $req->email;       
        ForgetPassword::updateOrCreate(
            ['email' => $email], // condition
            [
                'token' => $token,
                'created_at' => now(),
                'updated_at' => now(),
            ]
        );
        $data =[
            'name' => $admin->name,
            'token' => $token,
        ]; 
        try {
            Mail::send('email-template.forget-password.link', ['data' => $data], function($message) use ($subject, $email) {
                $message->to($email);
                $message->subject($subject);
            });    
            Log::channel('email')->info('Password Forgot Email sent successfully to ' . $email);    
        } catch (\Exception $mailException) {
            Log::channel('email')->info('Failed to send Password Forgot email to ' . $email . '. Error: ' . $mailException->getMessage());
            return redirect()->back()->with('error', 'Warning :'. $mailException->getMessage());
        }
        return back()->with('success','Password reset link send successfully, please check your inbox!');
    }

    public function showResetPasswordForm($token,){
        $existingToken = ForgetPassword::where('token', $token)->where('created_at', '>=', now()->subMinutes(10))->first();
        if(!$existingToken){
          return redirect()->route('admin.login')->with('error', 'Password Token Expired');
        }
        return view('admin.auth.password-forgot.update-password', ['token' => $token]);
    }

     public function updatePassword(Request $request){
        // dd($request->all());
        $request->validate([
            'token' => 'required',
            'password' => 'required',
        ]);
        $token = ForgetPassword::where('token',$request->token)->first();
        if(!$token){
            return back()->with('error','Invalid Token');
        }
        User::where('email', $token->email)->update([
         'password' => Hash::make($request->password)
        ]);
        $token->delete();
        return redirect()->route('admin.login')->with('success','Your Password Has Been Changed');
    }
}

