   public function updateCourse(Request $req){
        // dd($req->all());
        $req->validate([
            'course_id' => 'required|exists:courses,id',
            'overview' => 'nullable|string',
            'key' => 'required|array',
            'value' => 'required|array',
        ]);
        $course = Course::find($req->course_id);
        if(!$course){
            return back()->with('error','Course Not Found!');
        }
        $courseDetails = [];
        foreach ($req->key as $index => $key) {
            $courseDetails[] = [
                'key' => $key,
                'value' => $req->value[$index] ?? '',
            ];
        }
        $course->update([
            'overview' => $req->overview,
            'details' => json_encode($courseDetails), 
        ]);     
        return back()->with('success', 'Course details updated  successfully.');

    }

    

