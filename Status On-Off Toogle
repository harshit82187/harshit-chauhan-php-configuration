<style>
	/* Style for the toggle switch */
	.switch {
	position: relative;
	display: inline-block;
	width: 34px;
	height: 20px;
	}
	.switch input {
	opacity: 0;
	width: 0;
	height: 0;
	}
	.slider {
	position: absolute;
	cursor: pointer;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: #ccc;
	transition: .4s;
	border-radius: 34px;
	}
	.slider:before {
	position: absolute;
	content: "";
	height: 12px;
	width: 12px;
	border-radius: 50%;
	left: 4px;
	bottom: 4px;
	background-color: white;
	transition: .4s;
	}
	input:checked + .slider {
	background-color: #4CAF50;
	}
	input:checked + .slider:before {
	transform: translateX(14px);
	}
</style>
<meta name="csrf-token" content="{{ csrf_token() }}">


<td>
<label class="switch">
	 <input type="checkbox" class="status-toggle" data-id="{{ $blog->id }}" {{ $blog->status ? 'checked' : '' }}>
	<span class="slider round"></span>
</label>                                       
</td>


<script>
	$(document).ready(function() {
		$('.status-toggle').change(function() {
			var status = $(this).prop('checked') == true ? 1 : 0;
			var ferry_id = $(this).data('id');

			$.ajax({
				url: '{{ url('admin/ferry-update-status') }}',
				type: 'POST',
				data: {
					'_token': $('meta[name="csrf-token"]').attr('content'),
					'ferry_id': ferry_id,
					'status': status
				},
				success: function(response) {
					iziToast.info({
						title: 'Info',
						message: 'ferry status updated successfully!',
						position: 'topRight',
						timeout: 3000,
					});
				},
				error: function(xhr, status, error) {
					iziToast.error({
						title: 'Error',
						message: 'Error updating status!',
						position: 'topRight',
						timeout: 3000
					});
				}
			});
		});
	});
</script>

Route::post('admin/blogs/update-status', [BlogController::class, 'updateStatus'])->name('admin.blogs.updateStatus');
  


******************************************* Controller Side Code  ********************************************************


   public function updateStatus(Request $request)
    {
        // dd($request->all());
        $request->validate([
            'blog_id' => 'required|numeric',  
            'status' => 'required|boolean',  
        ]);
      

        $blog = Blog::findOrFail($request->blog_id);

        $blog->status = $request->status;
        $blog->save();

        return response()->json([
            'success' => true,
            'message' => 'Blog status updated successfully',
        ]);
    }
