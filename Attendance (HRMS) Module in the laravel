<?php 

namespace App\Http\Middleware;

use Closure;
use Illuminate\Support\Facades\Auth;
use App\Models\Attendance;

class CheckSessionExpired
{
    public function handle($request, Closure $next)
    {
        if (Auth::check()) {
            // Save current session state
            session(['last_active_user' => Auth::id()]);
        } elseif (session()->has('last_active_user')) {
            $user_id = session('last_active_user');
            $now = now();
            $today = $now->format('Y-m-d');
            $out_time = $now->format('H:i:s');

            // Attendance update
            $attendance = Attendance::where('user_id', $user_id)->where('date', $today)->first();
            if ($attendance && !$attendance->out_time) {
                $attendance->update(['out_time' => $out_time]);
            }

            // Clean up
            session()->forget('last_active_user');
        }

        return $next($request);
    }
}



