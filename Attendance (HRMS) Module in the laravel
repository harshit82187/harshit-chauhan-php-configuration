use App\Mail\Leave\LeaveNotification;
use App\Mail\Leave\LeaveUpdateStatusNotification;
use Illuminate\Support\Facades\Validator;


class HRMSController extends Controller
{

    public function index(Request $req)
    {
        $user = auth()->user();
        $leaveTypes = LeaveType::all();
        $attendances = Attendance::where('user_id', $user->id)->get()->keyBy('date'); 
        $leaves = Leave::with('leaveType')->where('user_id', $user->id)->get();      

        return view('admin.hrms.index', compact('attendances', 'leaveTypes', 'user'));
    }   

    public function store(Request $request){
        // dd($request->all());   
        $rules = [
            'user_id' => 'required|numeric',
            'name' => 'required|string',
            'leave_date' => 'required|date_format:d-m-Y',
            'leave_type_id' => 'required|numeric',
            'reason' => 'required|string',
        ];
        $validator = Validator::make($request->all(), $rules);
        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validation errors',
                'errors' => $validator->errors()
            ], 422);
        }
        $formattedDate = Carbon::createFromFormat('d-m-Y', $request->leave_date)->format('Y-m-d');
        $leave = Leave::create([
            'user_id'     => $request->user_id,
            'leave_type_id'    => $request->leave_type_id,
            'month'    => now()->format('M'),
            'leave_date'    => $formattedDate,
            'reason'    => $request->reason,
            'status' => 'Pending',
        ]);    
        $leave->load('leaveType');    
        $websiteName = BussinessSetting::where('type','name')->value('value');
        $adminEmail = BussinessSetting::where('type','email')->value('value');
        $email = $leave->user->email;
        $admin = User::where('user_type','admin')->first();
        $subject = "📝 Leave Request Notification - $request->name, {$leave->leaveType->name} for $formattedDate | $websiteName";
         try {
            Mail::to($email)->cc($adminEmail)->queue(new LeaveNotification($subject,$leave,$admin));  
            Log::channel('email')->info('Leave Notification Email sent successfully to ' . $email . ' and Admin: ' . $adminEmail);
        } catch (\Exception $mailException) {
            Log::channel('email')->error('Leave Notification Email Failed to send to ' . $email . ' and Admin: ' . $adminEmail. '. Error: ' . $mailException->getMessage());
        }

        return response()->json([
            'status' => true,
            'message' => 'Leave applied successfully!',
            'leave' => [
                'id' => $leave->id,
                'leave_date' => $leave->leave_date,
                'leaveType' => [
                    'name' => $leave->leaveType->name ?? '',
                ],
            ],
        ],200);
      
    }

     public function update(Request $request,$id){
        // dd($request->all(),$id);   
        $rules = [
            'user_id' => 'required|numeric|',
            'name' => 'required|string',
            'leave_date' => 'required|date',
            'leave_type_id' => 'required|numeric',
            'reason' => 'required|string',
            'remark' => 'required|string',
            'status' => 'required|string',
        ];
        $validator = Validator::make($request->all(), $rules);
        $user = auth()->user();
        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validation errors',
                'errors' => $validator->errors()
            ], 422);
        }
        $leave = Leave::findOrFail($id);
        $leave->update([
            'action_taken_user' => $user->id,
            'remark' => $request->remark,
            'status' =>  $request->status,
            'remark_added_at' => now(),
        ]);
        $websiteName = BussinessSetting::where('type','name')->value('value');
        $adminEmail = BussinessSetting::where('type','email')->value('value');
        $email = $leave->user->email;
        $admin = User::where('user_type','admin')->first();        
        if ($request->status === 'Approved') {
            $subject = "✔️ Leave Request Approved  - $request->name, {$leave->leaveType->name} for $request->leave_date | $websiteName";
            try {
                Mail::to($email)->cc($adminEmail)->queue(new LeaveUpdateStatusNotification($subject,$leave,$admin));  
                Log::channel('email')->info('Leave Approved Notification Email sent successfully to ' . $email . ' and Admin: ' . $adminEmail);
            } catch (\Exception $mailException) {
                Log::channel('email')->error('Leave Approved Notification Email Failed to send to ' . $email . ' and Admin: ' . $adminEmail. '. Error: ' . $mailException->getMessage());
            }
            flash(translate('Leave approved successfully!'))->success();
            return redirect('admin/leaves/listing');
        } elseif ($request->status === 'Rejected') {
             $subject = "❌ Leave Request Reject  - $request->name, {$leave->leaveType->name} for $request->leave_date | $websiteName";
            try {
                Mail::to($email)->cc($adminEmail)->queue(new LeaveUpdateStatusNotification($subject,$leave,$admin));  
                Log::channel('email')->info('Leave Reject Notification Email sent successfully to ' . $email . ' and Admin: ' . $adminEmail);
            } catch (\Exception $mailException) {
                Log::channel('email')->error('Leave Reject Notification Email Failed to send to ' . $email . ' and Admin: ' . $adminEmail. '. Error: ' . $mailException->getMessage());
            }
            flash(translate('Leave rejected successfully!'))->error();
            return redirect('admin/leaves/listing');
        }
        flash(translate('Leave updated successfully!'))->success();
        return redirect('admin/leaves/listing');
    }

    public function getEvents(Request $request){
        $user = auth()->user();
        $leaveTypes = LeaveType::all();
        $attendances = Attendance::where('user_id', $user->id)
            ->whereBetween('date', [$request->start, $request->end])
            ->get()
            ->keyBy('date');

        $leaves = Leave::with('leaveType')->where('user_id', $user->id)
            ->whereBetween('leave_date', [$request->start, $request->end])
            ->get();
        $joinDate = Carbon::parse($user->created_at)->startOfDay();
        $events = [];
        $startDate = Carbon::parse($request->start);
        $endDate = Carbon::parse($request->end);

        for ($date = $startDate->copy(); $date <= $endDate; $date->addDay()) {
            $dateStr = $date->format('Y-m-d');
            if ($date->lt($joinDate)) {
                continue;
            }
            $dayOfWeek = $date->dayOfWeek;

            // Sundays
            if ($dayOfWeek === 0) {
                $events[] = [
                    'id' => 'weekoff-' . $dateStr,
                    'title' => 'Week Off',
                    'start' => $dateStr,
                    'allDay' => true,
                    'color' => '#ffc107',
                    'classNames' => ['fc-disabled']
                ];
                continue;
            }

            if (isset($attendances[$dateStr])) {
                $a = $attendances[$dateStr];
                $events[] = [
                    'id' => 'attendance-' . $a->id,
                   'title' => 'In: ' . $a->in_time . ' |<br>Out: ' . $a->out_time,
                    'start' => $dateStr,
                    'allDay' => true,
                    'color' => '#007bff',
                ];
            } elseif ($date->lt(now())) {
                $events[] = [
                    'id' => 'absent-' . $dateStr,
                    'title' => 'In: N/A | Out: N/A',
                    'start' => $dateStr,
                    'allDay' => true,
                    'color' => '#6c757d',
                ];
            }
        }

        foreach ($leaves as $leave) {
            $events[] = [
                'id' => 'leave-' . $leave->id,
                'title' => 'Leavesss: ' . ($leave->leaveType->name ?? 'N/A'),
                'start' => $leave->leave_date,
                'allDay' => true,
                'color' => '#dc3545',
            ];
        }

        return response()->json(['events' => $events]);
    }


    public function leavesListing(){
        $user = auth()->user();
        if ($user->user_type === 'admin') {
            $leaves = Leave::with('user')->paginate(10);
        } else {
            $leaves = Leave::where('user_id', $user->id)->paginate(10);
        }
        $leaveTypes = LeaveType::all();
        return view('admin.hrms.view', compact('leaves','user','leaveTypes'));

    }

    public function holidays(){
        $holidays = Holiday::whereYear('date', 2025)->get()->groupBy(function($item) {
            return strtolower(date('M', strtotime($item->date))); // jan, feb, ...
        });
        // dd($holidays);
        return view('admin.hrms.holiday', compact('holidays'));
    }

    public function holidayStore(Request $req){
        // dd($req->all());
        $req->validate([
            'date' => 'required|date',
            'occasion' => 'required|string',
        ]);
        $holidayDate = Carbon::parse($req->date);
        $holiday = new Holiday(); 
        $holiday->month =$holidayDate->format('M');;
        $holiday->year = $holidayDate->format('Y');;
        $holiday->date = $req->date;
        $holiday->occasion = $req->occasion;
        $holiday->day = $holidayDate->format('l'); ;
        $holiday->user_id = auth()->user()->id;
        $holiday->save();
        flash(translate('Holiday Added Successfully'))->success();
        return redirect()->to(url('admin/holidays'));
    }

    public function leavesApplyNotification(){
        return view('emails.attendance.leave-apply-notification');
    }

   
    

   
   
