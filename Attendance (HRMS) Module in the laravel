<script>
	$(document).ready(function () {
	    var csrfToken = $('meta[name="csrf-token"]').attr('content');
	    var calendarEl = document.getElementById('calendar');
	    var calendar = new FullCalendar.Calendar(calendarEl, {
	        initialView: 'dayGridMonth',
	        editable: false,
	        selectable: true,
	        timeZone: 'local',
			events: function(fetchInfo, successCallback, failureCallback) {
				$.ajax({
					url: "{{ route('calendar.events') }}", // Add this route in web.php
					type: 'GET',
					data: {
						start: fetchInfo.startStr,
						end: fetchInfo.endStr
					},
					success: function(response) {
						successCallback(response.events);
					},
					error: function() {
						failureCallback();
					}
				});
			},
			selectAllow: function(selectionInfo) {
				const day = new Date(selectionInfo.startStr).getDay(); // 0 = Sunday
				return day !== 0;
			},
	        eventContent: function (arg) {
	            return {
	                html: `<div style="font-size: 15px;">${arg.event.title.replace('|', '')}</div>`
	            };
	        },
	        select: function (selectionInfo) {
	            let selectedDate = new Date(selectionInfo.startStr);
	            let formattedDate = selectedDate.toLocaleDateString('en-GB').split('/').join('-'); // dd-mm-yyyy

	            $('#leave_date').val(formattedDate);
	            $('#eventModal').modal('show');
	        }
	    });

	    calendar.render();

	    // AJAX form submit
	    $('#submit-button').on('click', function (e) {
	        e.preventDefault();
			let btn = $('button[type="submit"]');
			btn.html('<span class="spinner-border spinner-border-sm"></span> Please Wait...').prop('disabled', true).css('cursor', 'no-drop');
	        let formData = {
	            _token: csrfToken,
	            user_id: $('#user_id').val(),
	            name: $('#name').val(),
	            leave_date: $('#leave_date').val(),
	            leave_type_id: $('#leave_type_id').val(),
	            reason: $('#reason').val(),
	        };

	        $.ajax({
	            url: "{{ url('admin/hrms') }}",
	            type: 'POST',
	            data: formData,
	            success: function (response) {
	                $('#eventModal').modal('hide');
	                $('#reason').val(''); // Reset reason textarea
	                // Add new leave event to calendar
	                calendar.addEvent({
	                    id: 'leave-' + response.leave.id,
	                    title: 'Leave: ' + response.leave.leaveType.name,
	                    start: response.leave.leave_date,
	                    allDay: true,
	                    color: '#dc3545'
	                });
					let Message = response.message;
					AIZ.plugins.notify('success', Message);
	            },
	            error: function (xhr) {
	                let errorMessage = 'Something went wrong. Please try again.';
					if (xhr.responseJSON && xhr.responseJSON.message) {
						errorMessage = xhr.responseJSON.message;
					}
					AIZ.plugins.notify('danger', errorMessage);
					btn.html('Raise Request').prop('disabled', false).css('cursor', 'pointer');
	            }
	        });
	    });
	});
</script>
