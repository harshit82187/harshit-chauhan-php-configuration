        ]);

        // Fetch data from DB
        $earnings = DB::table('payments')
            ->select(
                DB::raw('MONTH(created_at) as month'),
                DB::raw('COALESCE(SUM(amount), 0) as total'),
                DB::raw('COALESCE(SUM(JSON_UNQUOTE(JSON_EXTRACT(taxes, "$[0].amount"))), 0) as cleaning_fee'),
