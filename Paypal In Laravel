<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use PayPalCheckoutSdk\Core\PayPalHttpClient;
use PayPalCheckoutSdk\Core\SandboxEnvironment;
use PayPalCheckoutSdk\Orders\OrdersCreateRequest;
use PayPalCheckoutSdk\Orders\OrdersCaptureRequest;
use Illuminate\Support\Facades\Log;
use App\Models\PaypalPayment;
use App\Models\PaypalOrderRequest;

class PayPalController extends Controller
{
    protected $client;

    public function __construct()
    {
        $env = new SandboxEnvironment(env('PAYPAL_CLIENT_ID'), env('PAYPAL_CLIENT_SECRET'));
        $this->client = new PayPalHttpClient($env);
    }

    public function showForm()
    {
        return view('paypal.form');
    }

    public function createOrder(Request $request)
    {
        $request->validate([
            'name' => 'required',
            'email' => 'required|email',
            'mobile_no' => 'required',
            'amount' => 'required|numeric'
        ]);

        Log::channel('paypal')->info("📝 Form data stored before creating order", $request->all());

        $order = new OrdersCreateRequest();
        $order->prefer('return=representation');
        $order->body = [
            'intent' => 'CAPTURE',
            'purchase_units' => [[
                'amount' => [
                    'currency_code' => 'USD',
                    'value' => number_format($request->amount, 2, '.', '')
                ]
            ]],
            'application_context' => [
                'cancel_url' => route('paypal.cancel'),
                'return_url' => route('paypal.success'),
            ]
        ];

        try {
            $response = $this->client->execute($order);
            Log::channel('paypal')->info("✅ PayPal Order Created", [
                'orderID' => $response->result->id,
                'status' => $response->statusCode,
                'links' => $response->result->links
            ]);

            foreach ($response->result->links as $link) {
                if ($link->rel === 'approve') {
                    PaypalOrderRequest::create([
                        'order_id' => $response->result->id,
                        'request_data' => json_encode($request->all())
                    ]);
                    return redirect()->away($link->href);
                }
            }

            return redirect()->back()->with('error', 'Unable to redirect to PayPal.');
        } catch (\Throwable $e) {
           Log::channel('paypal')->error("❌ PayPal Order Creation Error: " . $e->getMessage());
            return redirect()->route('paypal.failure')->with('error', 'Something went wrong.');
        }
    }

    public function captureOrder(Request $request) {
        $orderId = $request->get('token');

        $captureRequest = new OrdersCaptureRequest($orderId);
        $captureRequest->prefer('return=representation');

        try {
            $response = $this->client->execute($captureRequest);
            $result = $response->result;
            $purchase_unit = $result->purchase_units[0];

            $originalData = PaypalOrderRequest::where('order_id', $result->id)->first();
            if($originalData === null) {
                return response()->json(['success' => false, 'message' => 'Order not found.'], 404);
            }
            $formData = json_decode($originalData->request_data, true);

            PaypalPayment::create([
                'order_id'      => $result->id,
                'payment_id'    => $result->id,
                'payer_id'      => $result->payer->payer_id ?? null,
                'payer_email'   => $result->payer->email_address ?? null,
                'status'        => $result->status,
                'amount'        => $purchase_unit->payments->captures[0]->amount->value ?? 0,
                'currency'      => $purchase_unit->payments->captures[0]->amount->currency_code ?? 'USD',
                'json_response' => json_encode($result),
                'customer_info' => json_encode($formData),
            ]);

            Log::channel('paypal')->info("✅ PayPal Payment Captured", [
                'status' => $response->statusCode,
                'data' => $result
            ]);

            return view('paypal.success', ['data' => $result]);
        } catch (\Throwable $e) {
            Log::channel('paypal')->error("❌ PayPal Capture Error: " . $e->getMessage());
            return redirect()->route('paypal.failure')->with('error', 'Payment capture failed.');
        }
    }


    public function cancel()
    {
        return view('paypal.cancel');
    }

    public function failure()
    {
        return view('paypal.failure');
    }
}


