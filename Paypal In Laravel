-serif;\"><strong><span lang=\"EN-IN\" style=\"font-size: 16px; line-height: 107%; font-family: Arial, sans-serif; color: black;\">Automotive\r\n            Lead-Acid Battery Market Report Scope</span></strong></p>\r\n\r\n<table class=\"GridTable4-Accent51\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"630\" style=\"width: 627px;\">\r\n    <tbody>\r\n        <tr style=\"height: 21px;\">\r\n            <td width=\"264\" valign=\"top\" style=\"width: 263px; background: rgb(91, 155, 213); padding: 0in 7px; height: 21px;\">\r\n                <p class=\"MsoNormal\" style=\"margin: 0in 0in 11px; font-size: 15px; font-family: Calibri, sans-serif; text-align: justify; line-height: 150%;\"><strong><span style=\"font-size: 16px; line-height: 150%; font-family: Arial, sans-serif; color: black;\">Report Attribute</span></strong></p>\r\n            </td>\r\n            <td width=\"366\" valign=\"top\" style=\"width: 365px; background: rgb(91, 155, 213); padding: 0in 7px; height: 21px;\">\r\n                <p class=\"MsoNormal\" style=\"margin: 0in 0in 11px; font-size: 15px; font-family: Calibri, sans-serif; text-align: justify; line-height: 150%;\"><strong><span style=\"font-size: 16px; line-height: 150%; font-family: Arial, sans-serif; color: black;\">Details</span></strong></p>\r\n            </td>\r\n        </tr>\r\n        <tr style=\"height: 21px;\">\r\n            <td width=\"264\" valign=\"top\" style=\"width: 263px; background: rgb(222, 234, 246); padding: 0in 7px; height: 21px;\">\r\n                <p class=\"MsoNormal\" style=\"margin: 0in 0in 11px; font-size: 15px; font-family: Calibri, sans-serif; text-align: justify; line-height: 150%;\"><strong><span style=\"font-size: 16px; line-height: 150%; font-family: Arial, sans-serif; color: black;\">Market Value (2024)</span></strong></p>\r\n            </td>\r\n            <td width=\"366\" valign=\"top\" style=\"width: 365px; background: rgb(222, 234, 246); padding: 0in 7px; height: 21px;\">\r\n           