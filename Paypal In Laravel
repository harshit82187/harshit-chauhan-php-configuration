<?php

namespace App\Http\Controllers\API\Front;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;

use PayPalCheckoutSdk\Core\PayPalHttpClient;
use PayPalCheckoutSdk\Core\SandboxEnvironment;
use PayPalCheckoutSdk\Orders\OrdersCreateRequest;
use PayPalCheckoutSdk\Orders\OrdersCaptureRequest;
use App\Models\PaypalPayment;
use App\Models\Report;
use App\Models\PaypalOrderRequest;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Validator;
use Illuminate\Validation\Rule;

class PayPalController extends Controller
{
    protected $client;

    public function __construct()
    {
        $env = new SandboxEnvironment(env('PAYPAL_CLIENT_ID'), env('PAYPAL_CLIENT_SECRET'));
        $this->client = new PayPalHttpClient($env);
    }

    public function createOrder(Request $request)
    {
        $rules = [
            'name' => 'required',
            'email' => 'required|email',
            'mobile_no' => 'required',
            'amount' => 'required|numeric',
            'company_name' => 'required',
            'title' => 'required|string',
            'country' => 'required|exists:countries,id',
            'address' => 'required|string',
            'city' => 'required|string',
            'state' => 'required|string',
            'zip' => 'required|numeric',
            'report_id' => [
                'required',
                Rule::exists('reports', 'report_id')->whereNull('deleted_at')
            ],
        ];
        $validator = Validator::make($request->all(), $rules);
        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validation errors',
                'errors' => $validator->errors()
            ], 422);
        }

        $order = new OrdersCreateRequest();
        $order->prefer('return=representation');
        $order->body = [
            'intent' => 'CAPTURE',
            'purchase_units' => [[
                'amount' => [
                    'currency_code' => 'USD',
                    'value' => number_format($request->amount, 2, '.', '')
                ]
            ]],
            'application_context' => [
                'cancel_url' => env('FRONTEND_CANCEL_URL'),
                'return_url' => env('FRONTEND_SUCCESS_URL'),
            ]
        ];

        try {
            $response = $this->client->execute($order);
            foreach ($response->result->links as $link) {
                if ($link->rel === 'approve') {
                    PaypalOrderRequest::create([
                        'order_id' => $response->result->id,
                        'request_data' => json_encode($request->all())
                    ]);
                    Log::channel('paypal')->info("API PayPal Order Created: " . $response->result->id);
                    return response()->json([
                        'success' => true,
                        'order_id' => $response->result->id,
                        'approval_url' => $link->href
                    ]);
                }
            }
            return response()->json(['success' => false, 'message' => 'Approval URL not found.'], 500);
        } catch (\Throwable $e) {
            Log::channel('paypal')->error("API PayPal Order Creation Error: " . $e->getMessage());
            return response()->json(['success' => false, 'message' => 'Error creating PayPal order.'], 500);
        }
    }

    public function captureOrder(Request $request)
    {
        $orderId = $request->get('token');
        if (!$orderId) {
            return response()->json(['success' => false, 'message' => 'Missing token parameter.'], 400);
        }

        $captureRequest = new OrdersCaptureRequest($orderId);
        $captureRequest->prefer('return=representation');

        try {
            $response = $this->client->execute($captureRequest);
            $result = $response->result;
            $purchase_unit = $result->purchase_units[0];
            $originalData = PaypalOrderRequest::where('order_id', $result->id)->first();
            if($originalData === null) {
                return response()->json(['success' => false, 'message' => 'Order not found.'], 404);
            }
            $formData = json_decode($originalData->request_data, true);
            $report_id = $formData['report_id'] ?? null;
            $report = Report::where('report_id', $report_id)->first();
            if($report === null) {
                return response()->json(['success' => false, 'message' => 'Report not found.'], 404);
            }
            // Log::channel('paypal')->info("Report Fetch Successfully! " . $report);

            PaypalPayment::create([
                'order_id'      => $result->id,
                'payment_id'    => $result->id,
                'payer_id'      => $result->payer->payer_id ?? null,
                'payer_email'   => $result->payer->email_address ?? null,
                'status'        => $result->status,
                'amount'        => $purchase_unit->payments->captures[0]->amount->value ?? 0,
                'currency'      => $purchase_unit->payments->captures[0]->amount->currency_code ?? 'USD',
                'json_response' => json_encode($result),
                'customer_info' => json_encode($formData),
            ]);

            return response()->json([
                'success' => true,
                'message' => 'Payment captured successfully.',
                'report' => $report,
                'order_id' => $result->id,
                'data' => $result
            ]);
        } catch (\Throwable $e) {
            Log::channel('paypal')->error("API PayPal Capture Error: " . $e->getMessage());
            return response()->json([
                'success' => false,
                'message' => 'Payment capture failed.'
            ], 500);
        }
    }
}



