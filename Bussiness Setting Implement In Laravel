   public function websiteProfile(Request $req){
        // dd($req->all());
        $fields = [
            4 => 'name',
            5 => 'mobile_no1',
            6 => 'email',
            7 => 'address',
            8 => 'mobile_no2',
            9 => 'map_link',
        ];

        foreach ($fields as $id => $field) {
            $row = BussinessSetting::find($id);
