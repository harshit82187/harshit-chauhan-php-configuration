    }

    #guestRoomModal .close-btn {
        background-color: #f44336;
        color: white;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    #guestRoomModal .close-btn:hover {
        background-color: #d32f2f;
    }

    /* Modal Animation */
    @keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.7);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* For the 'guests' input field */
