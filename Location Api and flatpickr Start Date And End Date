<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">


<form action="{{ url()->current() }}" method="get" >  
            <div class="search-bar">
                <input type="text" class="location" id="location" name="location" placeholder="Enter Your Location">
                <div id="suggestions"></div>
                <div class="date-picker-container">
                    <input type="text" name="check-in" class="date-picker" id="check-in" placeholder="Check-In Date">
                </div>
                <div class="date-picker-container">
                    <input type="text" name="check-out" class="date-picker" id="check-out" placeholder="Check-Out Date">
                </div>
                <div class="date-picker-container">
                    <input type="text" class="guests" name="" readonly>
                    <input type="hidden" name="guest" readonly>
                    <input type="hidden" name="room" readonly>
                
                    <!-- Beautiful Modal for Selecting Rooms and Guests -->
                    <div class="modal" id="guestRoomModal">
                        <div class="modal-content">
                            <div class="calendar">
                                <div class="hide-button">
                                    <span>Rooms</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="increment" data-counter="roomCounter">+</button>
                                        <span id="roomCounter">1</span>
                                        <button type="button" class="decrement" data-counter="roomCounter">-</button>
                                    </div>
                                </div>
                                <div class="hide-button">
                                    <span>Guest</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="increment" data-counter="guestCounter">+</button>
                                        <span id="guestCounter">1</span>
                                        <button type="button" class="decrement" data-counter="guestCounter">-</button>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" id="closeModal" class="close-btn">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="search-btn">Search</button>
            </div>
</form>





*************************************************** script file code ************************************************************




<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDuMG2WaY4Vwi0iM3XqPdUrNAcvjHtR8wE&libraries=places"></script>




<script>
    $(document).ready(function() {
        $('.guests').click(function() {
            $('#guestRoomModal').fadeIn();
        });
        $('#closeModal').click(function() {
            $('#guestRoomModal').fadeOut();
        });
        $('.increment').click(function() {
            var counterId = $(this).data('counter');
            var currentValue = parseInt($('#' + counterId).text());
            currentValue++;
            $('#' + counterId).text(currentValue);
            updateHiddenInputs();
        });

        $('.decrement').click(function() {
            var counterId = $(this).data('counter');
            var currentValue = parseInt($('#' + counterId).text());

            // Prevent going below 1
            if (currentValue > 1) {
                currentValue--;
                $('#' + counterId).text(currentValue);
            }
            updateHiddenInputs();
        });
        function updateHiddenInputs() {
            var roomValue = $('#roomCounter').text();
            var guestValue = $('#guestCounter').text();
            $('input[name="room"]').val(roomValue);
            $('input[name="guest"]').val(guestValue);
            $('input.guests').val(roomValue + ' Room(s) | ' + guestValue + ' Guest(s)');
        }
        updateHiddenInputs();
    });
</script>

<script>
    $(document).ready(function () {
        const input = document.getElementById('location');
        const options = {
            types: ['(cities)'] 
        };
        const autocomplete = new google.maps.places.Autocomplete(input, options);
        autocomplete.setFields(['address_components', 'geometry', 'formatted_address']);
        autocomplete.addListener('place_changed', function () {
            const place = autocomplete.getPlace();
            if (place.formatted_address) {
                console.log('Selected City:', place.formatted_address);
            } else {
                alert('No valid city selected');
            }
        });
    });
</script>

<script>
    $(document).ready(function () {
       let today = new Date().toISOString().split('T')[0];
   
       $('#check_in').flatpickr({
           dateFormat: "Y-m-d",
           altInput: true,
           altFormat: "F j, Y",
           minDate: today, 
           allowInput: true,
           onChange: function (selectedDates, dateStr) {
               $('#check_out').flatpickr({
                   dateFormat: "Y-m-d",
                   altInput: true,
                   altFormat: "F j, Y",
                   minDate: dateStr, 
                   allowInput: true,
               });
           },
       });
   
       $('#check_out').flatpickr({
           dateFormat: "Y-m-d",
           altInput: true,
           altFormat: "F j, Y",
           minDate: today, 
           allowInput: true,
       });
   });
</script>













