	public function subscriber(){

			$emailExist =  DB::table('subscribers')->where('email','=',$_POST['email'])->first()->toArray();
			if($emailExist){				
				return redirect("?error=subscribe");
			}else{
				$values = [
					'email' => $_POST['email'],				
					'created_at' => date('Y-m-d H:i:s'),
					'updated_at' => date('Y-m-d H:i:s'),
				];
				DB::table('subscribers')->insert($values);
				return redirect("?success=subscribe");
			}
		
		}




