Step :3 PdfController Side Code 

<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use setasign\Fpdi\Fpdi;

class PDFController extends Controller
{
    /**
     * Modify and output the CRM Certificate PDF with dynamic data.
     *
     * @return void
     */
    public function modify()
    {
        $pdf = new Fpdi();
        $sourcePath = resource_path('views/pdf/crm/coc.pdf');

        // Load the source PDF
        $pageCount = $pdf->setSourceFile($sourcePath);

        for ($i = 1; $i <= $pageCount; $i++) {
            $templateId = $pdf->importPage($i);
            $size = $pdf->getTemplateSize($templateId);
            $orientation = ($size['width'] > $size['height']) ? 'L' : 'P';
            $pdf->AddPage($orientation, [$size['width'], $size['height']]);
            $pdf->useTemplate($templateId, 0, 0, $size['width'], $size['height']);

            if ($i === 1) {
                $pdf->SetFont('Times', '', 12);
                $this->addFirstPageContent($pdf);
            }
        }


        // Output PDF in browser
        $pdf->Output('I', 'modified.pdf');
    }

    /**
     * Add dynamic content to the first page of the PDF.
     *
     * @param Fpdi $pdf
     * @return void
