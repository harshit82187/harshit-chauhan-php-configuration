✅ STEP 2 — Create Visitor Middleware (tracks visitor automatically)
php artisan make:middleware TrackVisitors


<?php 

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;
use App\Models\Visitors;

class TrackVisitors
{
    public function handle(Request $request, Closure $next)
    {
        // Skip admin panel
        if ($request->is('admin/*')) {
            return $next($request);
        }

        if (!session()->has('visitor_logged')) {
            session()->put('visitor_logged', true);
            Visitors::create([
                'ip' => $request->ip(),
                'browser'    => $this->getBrowser($request),
                'device'     => $this->getDevice($request->header('User-Agent')),
                'platform'   => $this->getPlatform($request->header('User-Agent')),
            ]);
        }

        return $next($request);
    }

    private function getBrowser(Request $request)
    {
        $agent = $request->header('User-Agent');
        if (strpos($agent, 'Firefox') !== false) return 'Firefox';
        if (strpos($agent, 'Chrome') !== false) return 'Chrome';
        if (strpos($agent, 'Safari') !== false) return 'Safari';
        if (strpos($agent, 'Opera') !== false) return 'Opera';
        return 'Unknown';
    }

    private function getDevice($agent)
    {
        if (preg_match('/mobile/i', $agent)) return 'Mobile';
        if (preg_match('/tablet/i', $agent)) return 'Tablet';
        return 'Desktop';
    }

    private function getPlatform($agent)
    {
        if (preg_match('/windows/i', $agent)) return 'Windows';
        if (preg_match('/macintosh|mac os x/i', $agent)) return 'Mac';
        if (preg_match('/linux/i', $agent)) return 'Linux';
        if (preg_match('/android/i', $agent)) return 'Android';
        if (preg_match('/iphone|ipad/i', $agent)) return 'iOS';
        return 'Unknown';
    }
}



