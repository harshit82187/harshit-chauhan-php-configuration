<?php

namespace App\Http\Controllers;
use Log;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Auth;
use Illuminate\Http\Request;
use App\Models\CashfreePayment;
use Carbon\Carbon;

class CashfreeController extends Controller
{

    protected $appId;
    protected $secretKey;
    protected $mode;
    protected $baseUrl;

    public function __construct()
    {
        $this->appId     = config('services.cashfree.app_id');
        $this->secretKey = config('services.cashfree.secret_key');
        $this->mode      = config('services.cashfree.mode');
        $this->baseUrl   = $this->mode === 'production'
            ? config('services.cashfree.production_url')
            : config('services.cashfree.sandbox_url');
    }

    public function showPaymentForm(){
        return view('cashfree.index');
    }

    public function createOrder(Request $request)
    {
        $request->validate([
            'name'      => 'required|string|max:255',
            'email'     => 'required|email',
            'mobile_no' => 'required|string',
            'amount'    => 'required|numeric|min:1',
        ]);
        $orderId = 'grievance_' . uniqid();
        session(['cashfree_data_' . $orderId => $request->except('_token')]);

        $response = Http::withHeaders([
                'x-api-version'   => '2023-08-01',
                'x-client-id'     => $this->appId,
                'x-client-secret' => $this->secretKey,
            ])->post("{$this->baseUrl}/orders", [
                'order_id'       => $orderId,
                'order_amount'   => $request->amount,
                'order_currency' => 'INR',
                'customer_details' => [
                    'customer_id'    => 'cust_' . uniqid(),
                    'customer_name'  => $request->name,
                    'customer_email' => $request->email,
                    'customer_phone' => $request->mobile_no,
                ],
                'order_meta' => [
                    'return_url' => route('cashfree.callback') . '?order_id={order_id}',
                    'notify_url' => url('/webhook'),
                ],
        ]);

        if ($response->successful()) {
            return response()->json($response->json());
        }
        Log::channel('cashfree')->error('Cashfree API Error', [
            'status' => $response->status(),
            'body' => $response->body(),
        ]);

        return response()->json([
            'error' => 'Failed to create Cashfree order',
            'details' => $response->json() ?: $response->body(),
        ], $response->status());
    }


    public function handleCallback(Request $request)
    {
        $orderId = $request->query('order_id');
        if (!$orderId) {
            return redirect()->route('cashfree.failed')->with('error', 'Order ID missing.');
        }

        $orderResponse = Http::withHeaders([
            'x-api-version'   => '2023-08-01',
            'x-client-id'     => $this->appId,
            'x-client-secret' => $this->secretKey,
        ])->get("{$this->baseUrl}/orders/{$orderId}");

        if (!$orderResponse->successful()) {
            Log::channel('cashfree')->error('Failed to retrieve order details', [
                'order_id' => $orderId,
                'response' => $orderResponse->body(),
            ]);
            return redirect()->route('cashfree.failed')->with('error', 'Unable to fetch payment status.');
        }

        $orderDetails = $orderResponse->json();
        $sessionData  = session('cashfree_data_' . $orderId);

        if (!$sessionData) {
            return redirect()->route('cashfree.failed')->with('error', 'Session expired. Try again.');
        }

        // Fetch payment details
        $paymentResponse = Http::withHeaders([
            'x-api-version'   => '2022-01-01',
            'x-client-id'     => $this->appId,
            'x-client-secret' => $this->secretKey,
        ])->get("{$this->baseUrl}/orders/{$orderId}/payments");

        $paymentData = $paymentResponse->successful() ? ($paymentResponse->json()[0] ?? []) : [];

        if ($orderDetails['order_status'] === 'PAID') {
            CashfreePayment::updateOrCreate(
                ['order_id' => $orderId],
                [
                    'order_details' => json_encode($orderDetails),
                    'payment_info'  => json_encode($paymentData),
                    'status'        => $orderDetails['order_status'],
                    'paid_at'       => isset($paymentData['payment_time'])
                        ? Carbon::parse($paymentData['payment_time'])->format('Y-m-d H:i:s')
                        : now(),
                ]
            );

            return redirect()->route('cashfree.success', ['order_id' => $orderId])
                ->with('success', 'Payment successful.');
        }

        return redirect()->route('cashfree.failed')->with('error', 'Payment not completed.');
    }


    public function showSuccessPage(Request $request)
    {
        $orderId = $request->query('order_id');
        $payment = CashfreePayment::where('order_id', $orderId)->first();

        if (!$payment) {
            return redirect()->route('cashfree.index')->with('error', 'Payment record not found.');
        }

        $orderDetails = json_decode($payment->order_details, true);
        $paymentInfo  = json_decode($payment->payment_info, true);
        $paymentDetails = array_merge($orderDetails, ['payment_info' => $paymentInfo]);

        return view('cashfree.thank-you', compact('paymentDetails'));
    }

    public function showFailurePage()
    {
        return view('cashfree.failed');
    }


}





