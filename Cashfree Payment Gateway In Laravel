<script>
    $(document).ready(function() {
        $('#generate-order').submit(async function(e) {
            e.preventDefault();

            const submitBtn = $('#proceedToPay');
            submitBtn.prop('disabled', true).text('Please wait...');

            const formData = new FormData(this);

            try {
                const response = await fetch('{{ route("cashfree.order.create") }}', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': '{{ csrf_token() }}'
                    },
                    body: formData
                });

                const data = await response.json();

                if (data.error) {
                    alert('❌ Error creating order: ' + (data.details?.message || 'Unknown error'));
                    submitBtn.prop('disabled', false).text('💳 Pay Now');
                    return;
                }

                const cashfree = Cashfree({ mode: "{{ config('services.cashfree.mode', 'sandbox') }}" });

                cashfree.checkout({
                    paymentSessionId: data.payment_session_id,
                    redirectTarget: "_self",
                    returnUrl: "{{ route('cashfree.callback') }}?order_id=" + data.order_id,
                });

            } catch (error) {
                alert('❌ Failed to initiate payment. Please try again.');
                console.error(error);
                submitBtn.prop('disabled', false).text('💳 Pay Now');
            }
        });
    });
</script>

