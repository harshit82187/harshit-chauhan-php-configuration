use App\Exports\SeatDataExport;
use Maatwebsite\Excel\Facades\Excel;
use Carbon\Carbon;

    public function seatDataDownload($value)
    {
        try {
            $startDate = null;
            $endDate = null;

            switch ($value) {
                case 2:
                    // Next 7 days expiry
                    $startDate = Carbon::today()->toDateString();
                    $endDate   = Carbon::today()->addDays(7)->toDateString();
                    break;

                case 3:
                    // Next 3 days expiry
                    $startDate = Carbon::today()->toDateString();
                    $endDate   = Carbon::today()->addDays(3)->toDateString();
                    break;

                case 4:
                    // Next 15 days expiry
                    $startDate = Carbon::today()->toDateString();
                    $endDate   = Carbon::today()->addDays(15)->toDateString();
                    break;

                case 5:
                    // Next 30 days expiry
                    $startDate = Carbon::today()->toDateString();
                    $endDate   = Carbon::today()->addDays(30)->toDateString();
                    break;

                case 6:
                    // Active bookings only
                    $startDate = null;
                    $endDate   = null;
                    break;

                default:
                    Toastr::error('Warning: Invalid Input');
                    return redirect()->route('admin.book-seat');
            }
            // dd($startDate, $endDate);
            $fileName = 'seat-data-export-' . now()->format('Y-m-d') . '-case-' . $value . '.xlsx';
            return Excel::download(
                new SeatDataExport($startDate, $endDate, $value), $fileName
            );

        } catch (\Exception $e) {
            Toastr::error('Warning: ' . $e->getMessage());
            return redirect()->back();
        }
    }




