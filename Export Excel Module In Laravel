<?php

namespace App\Exports;

use App\Models\Bookings;
use Illuminate\Support\Collection;
use Maatwebsite\Excel\Concerns\FromCollection;
use Maatwebsite\Excel\Concerns\WithHeadings;
use Maatwebsite\Excel\Concerns\WithMapping;
use Maatwebsite\Excel\Concerns\WithColumnWidths;
use Maatwebsite\Excel\Concerns\WithStyles;

use PhpOffice\PhpSpreadsheet\Worksheet\Drawing;
use PhpOffice\PhpSpreadsheet\Worksheet\MemoryDrawing;
use PhpOffice\PhpSpreadsheet\Worksheet\Worksheet;

use PhpOffice\PhpSpreadsheet\Style\Fill;
use Carbon\Carbon;


class SeatDataExport implements FromCollection, WithHeadings, WithMapping, WithStyles, WithColumnWidths
{
    protected $startDate;
    protected $endDate;
    protected $index = 1;


    public function __construct($startDate, $endDate)
    {
        $this->startDate = $startDate;
        $this->endDate   = $endDate;
    }

    public function collection()
    {
        $query = Bookings::with(['user', 'seat', 'hall']);

        if ($this->startDate === null && $this->endDate === null) {
            $data = $query->whereDate('expiry_date', '>=', now()->toDateString())->get();
        } else {
            $data = $query
                ->whereDate('expiry_date', '>=', $this->startDate)
                ->whereDate('expiry_date', '<=', $this->endDate)
                ->get();
        }

        if ($data->count() == 0) {
            return collect([[
                'No Data Found', '', '', '', '', '', '', ''
            ]]);
        }
        return $data;
    }


    // Map each row
    public function map($booking): array
    {
        if (is_string($booking[0])) {
                return [
                    $booking[0], '', '', '', '', '', '', ''
                ];
        }     
            
        $seatNumbers = $booking->seat_ids ? explode(',', $booking->seat_ids) : [];

        return [
            $this->index++,
            optional($booking->user)->name ?? '',
            optional($booking->user)->email ?? '',
            optional($booking->user)->phone ?? '',
            optional($booking->hall)->name ?? '',
            implode(", ", $seatNumbers),
            $booking->start_date ? Carbon::parse($booking->start_date)->format('d-M-Y') : '',
            $booking->expiry_date ? Carbon::parse($booking->expiry_date)->format('d-M-Y') : '',
        ];
    }

    // Excel headings
    public function headings(): array
    {
        return [
            'SL',
            'Student Name',
            'Student Email',
            'Mobile No',
            'Hall Name',
            'Seat No',
            'Booking Date',
            'Expiry Date',
        ];
    }

    public function columnWidths(): array
    {
        return [
            'A' => 6,   // SL
            'B' => 20,  // Student Name
            'C' => 35,  // Student Email
            'D' => 15,  // Mobile No
            'E' => 10,  // Hall No
            'F' => 15,  // Seat No
            'G' => 18,  // Booking Date
            'H' => 18,  // Expiry Date
        ];
    }


   public function styles(Worksheet $sheet)
    {
        // Header Styling
        $sheet->getStyle('A1:H1')->applyFromArray([
            'fill' => [
                'fillType'   => Fill::FILL_SOLID,
                'startColor' => [
                    'rgb' => '063C93',
                ],
            ],
            'font' => [
                'bold' => true,
                'size' => 11,
                'color' => [
                    'rgb' => 'FFFFFF',
                ],
            ],
            'alignment' => [
                'horizontal' => 'center',
                'vertical'   => 'center',
            ],
        ]);

          // Header Height
         $sheet->getRowDimension(1)->setRowHeight(25); 

         // No Data Found Row
         if ($sheet->getHighestRow() == 2) {
            $sheet->getStyle('A2:H2')->applyFromArray([
                'font' => [
                    'bold' => true,
                    'size' => 12,
                    'color' => ['rgb' => 'FF0000'], // Red
                ],
                'alignment' => [
                    'horizontal' => 'center',
                    'vertical'   => 'center',
                ],
            ]);
            $sheet->mergeCells('A2:H2');
        }

        // BLACK BORDER (Heading + Entire Data)
         $sheet->getStyle('A1:H' . $sheet->getHighestRow())
            ->applyFromArray([
                'borders' => [
                    'allBorders' => [
                        'borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN,
                        'color' => ['rgb' => '000000'], // Black
                    ],
                ],
            ]);
        return [];
    }


}























